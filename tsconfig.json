{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "paths": {
            "@/*": ["./src/*"],
            "@screenshots/desktop/*": [
                "./src/assets/images/desktop/screenshots/*"
            ],
            "@screenshots/mobile/*": [
                "./src/assets/images/mobile/screenshots/*"
            ]
        }
    }
}
