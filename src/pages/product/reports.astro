---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import ProductHero from "../../components/ProductHero.astro";
import reportsDesktop from "@screenshots/desktop/reports-page.png";
import reportsMobile from "@screenshots/mobile/hasibu-report-module.png";

// Trust chips under the hero copy.
const chips = [
    {
        label: "Live dashboards",
        icon: "hugeicons:dashboard-square-02",
        color: "text-blue-600",
    },
    {
        label: "Filter & sort",
        icon: "hugeicons:filter",
        color: "text-teal-600",
    },
    {
        label: "Branded PDF export",
        icon: "hugeicons:pdf-01",
        color: "text-amber-500",
    },
    {
        label: "Financial statements",
        icon: "hugeicons:analytics-up",
        color: "text-green-600",
    },
];

// Content sourced from the real Hasibu reporting capabilities. Copy avoids em dashes by preference.
const features = [
    {
        title: "Live dashboards",
        icon: "hugeicons:dashboard-square-02",
        desc: "Top-line numbers that respond to the filters you apply, so revenue, orders and stock figures update the moment you slice the data.",
    },
    {
        title: "Filter, sort and slice",
        icon: "hugeicons:filter",
        desc: "Every report filters by date, location, product and staff, and the filters and sort you choose carry straight through to the export.",
    },
    {
        title: "Branded PDF and spreadsheet export",
        icon: "hugeicons:file-export",
        desc: "Export any list as CSV, spreadsheet or a branded PDF carrying your business name, the active filters, row count and a Powered by Hasibu footer.",
    },
    {
        title: "Financial statements",
        icon: "hugeicons:book-open-01",
        desc: "Profit and loss, balance sheet and tax reports drawn straight from the general ledger, ready for your accountant or the regulator.",
    },
    {
        title: "Per-location and consolidated",
        icon: "hugeicons:store-01",
        desc: "Read each branch on its own or the whole business rolled up, from the same report and the same numbers.",
    },
    {
        title: "Report subscriptions",
        icon: "hugeicons:mail-01",
        desc: "Subscribe to the reports that matter and have them delivered on a schedule, so the figures reach you without logging in.",
    },
];
---

<BaseLayout
    title="Reports & Analytics — Hasibu"
    description="Reporting for African SMEs. Live dashboards, filterable reports, branded PDF and spreadsheet exports, financial statements, and per-location or consolidated views."
>
    <ProductHero
        badge="Reports & Analytics"
        chips={chips}
        desktopImg={reportsDesktop}
        mobileImg={reportsMobile}
        imgAlt="Hasibu reports module: dashboards, exports and statements"
        toolbarUrl="business.hasibu.africa/reports"
    >
        <Fragment slot="title">
            Numbers you<br />
            <span class="text-brand">can act on.</span>
        </Fragment>
        <Fragment slot="blurb">
            See sales, stock and finance across every branch in one place,
            filter to the answer you need, and export it as a branded report in
            a click.
        </Fragment>

        <!-- Floating annotated callouts over the screenshot -->
        <Fragment slot="overlay">
            <!-- Build any report yourself -->
            <div
                class="hero-callout absolute -top-5 left-6 hidden max-w-[13rem] items-start gap-2.5 rounded-xl border border-slate-100 bg-white px-3 py-2.5 shadow-xl lg:flex"
                style="--fd:.1s"
            >
                <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-brand">
                    <svg
                        class="tune-ico size-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path d="M4 7 H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <path d="M4 12 H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <path d="M4 17 H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <circle class="knob k1" cx="9" cy="7" r="2.6" fill="white" stroke="currentColor" stroke-width="2" />
                        <circle class="knob k2" cx="15" cy="12" r="2.6" fill="white" stroke="currentColor" stroke-width="2" />
                        <circle class="knob k3" cx="8" cy="17" r="2.6" fill="white" stroke="currentColor" stroke-width="2" />
                    </svg>
                </span>
                <div class="leading-tight">
                    <p class="text-sm font-semibold text-brand-dark">Build it yourself</p>
                    <p class="text-xs text-slate-400">Any metric, sliced any way</p>
                </div>
            </div>

            <!-- Scheduled to your inbox -->
            <div
                class="hero-callout absolute -top-5 right-4 hidden max-w-[13rem] items-start gap-2.5 rounded-xl border border-slate-100 bg-white px-3 py-2.5 shadow-xl lg:flex"
                style="--fd:.5s"
            >
                <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-lg bg-teal-50 text-teal-600">
                    <Icon name="material-symbols:schedule-send-outline" class="size-4" />
                </span>
                <div class="leading-tight">
                    <p class="text-sm font-semibold text-brand-dark">Scheduled to inbox</p>
                    <p class="text-xs text-slate-400">Daily, weekly, on shift close</p>
                </div>
            </div>

            <!-- Every branch, separately or combined -->
            <div
                class="hero-callout absolute top-1/3 -left-6 hidden max-w-[12rem] items-start gap-2.5 rounded-xl border border-slate-100 bg-white px-3 py-2.5 shadow-xl lg:flex"
                style="--fd:.9s"
            >
                <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-brand">
                    <Icon name="material-symbols:store-outline" class="size-4" />
                </span>
                <div class="leading-tight">
                    <p class="text-sm font-semibold text-brand-dark">Any branch, or all</p>
                    <p class="text-xs text-slate-400">Filter by location</p>
                </div>
            </div>

            <!-- Tap to drill in -->
            <div
                class="hero-callout absolute top-2/3 -right-6 hidden max-w-[12rem] items-start gap-2.5 rounded-xl border border-slate-100 bg-white px-3 py-2.5 shadow-xl lg:flex"
                style="--fd:1.3s"
            >
                <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-purple-600">
                    <Icon name="material-symbols:touch-app-outline" class="size-4" />
                </span>
                <div class="leading-tight">
                    <p class="text-sm font-semibold text-brand-dark">Tap to drill in</p>
                    <p class="text-xs text-slate-400">Top 10 to the sales behind</p>
                </div>
            </div>

            <!-- Branded export -->
            <div
                class="hero-callout absolute -bottom-5 left-10 hidden max-w-[12rem] items-start gap-2.5 rounded-xl border border-slate-100 bg-white px-3 py-2.5 shadow-xl lg:flex"
                style="--fd:1.7s"
            >
                <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-lg bg-slate-50">
                    <svg
                        class="dl-ico size-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                    >
                        <!-- arrow: shaft + head (same teal as the tray) -->
                        <rect
                            class="dl-shaft"
                            x="10.9"
                            y="2.5"
                            width="2.2"
                            height="12.5"
                            rx="1.1"
                            fill="#06b6d4"
                        />
                        <path
                            class="dl-head"
                            d="M7 12.5 L12 17 L17 12.5"
                            stroke="#06b6d4"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                        <!-- tray (teal U, wider) -->
                        <path
                            d="M4.5 17 v3.5 h15 v-3.5"
                            stroke="#06b6d4"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </span>
                <div class="leading-tight">
                    <p class="text-sm font-semibold text-brand-dark">Branded export</p>
                    <p class="text-xs text-slate-400">PDF or Excel, one tap</p>
                </div>
            </div>
        </Fragment>
    </ProductHero>

    <!-- Features -->
    <section class="bg-slate-100 py-20 lg:py-28">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
                >
                    From raw sales to a signed-off report
                </h2>
                <p class="mt-4 text-slate-500">
                    Every list in Hasibu is a report waiting to be filtered,
                    sorted and exported, with the same branded output across the
                    platform.
                </p>
            </div>

            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    features.map((f) => (
                        <article class="flex flex-col rounded-2xl bg-slate-100 p-6 shadow-[6px_6px_12px_#c9cfdd,-6px_-6px_12px_#ffffff] transition hover:shadow-[8px_8px_16px_#c2c9d9,-8px_-8px_16px_#ffffff]">
                            <div class="flex size-11 items-center justify-center rounded-xl bg-slate-100 text-brand shadow-[inset_3px_3px_6px_#c9cfdd,inset_-3px_-3px_6px_#ffffff]">
                                <Icon name={f.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                {f.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {f.desc}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white py-10 lg:py-14">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        Stop exporting to spreadsheets by hand
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href="https://app.hasibu.africa/signup"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* Download icon: the arrow shaft lengthens downward toward the tray, the
       head follows, then resets. */
    .dl-shaft {
        transform-box: fill-box;
        transform-origin: center top;
        animation: dl-grow 2s ease-in-out infinite;
    }
    .dl-head {
        transform-box: fill-box;
        animation: dl-drop 2s ease-in-out infinite;
    }
    @keyframes dl-grow {
        0% { transform: scaleY(0.45); }
        50%, 78% { transform: scaleY(1); }
        100% { transform: scaleY(0.45); }
    }
    @keyframes dl-drop {
        0% { transform: translateY(-7px); }
        50%, 78% { transform: translateY(0); }
        100% { transform: translateY(-7px); }
    }
    /* Sliders icon: knobs slide along their tracks. */
    .k1 { animation: knob-a 4s ease-in-out infinite -0.6s; }
    .k2 { animation: knob-b 4.8s ease-in-out infinite -2.4s; }
    .k3 { animation: knob-c 3.6s ease-in-out infinite -1.3s; }
    /* slide to a value, hold, slide back, hold — like a real adjustment */
    @keyframes knob-a {
        0%, 18% { transform: translateX(0); }
        40%, 58% { transform: translateX(6px); }
        80%, 100% { transform: translateX(0); }
    }
    @keyframes knob-b {
        0%, 18% { transform: translateX(0); }
        40%, 58% { transform: translateX(-5px); }
        80%, 100% { transform: translateX(0); }
    }
    @keyframes knob-c {
        0%, 18% { transform: translateX(0); }
        40%, 58% { transform: translateX(4px); }
        80%, 100% { transform: translateX(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .dl-shaft,
        .dl-head,
        .knob {
            animation: none;
        }
    }
</style>
