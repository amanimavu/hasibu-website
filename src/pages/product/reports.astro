---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import ProductHero from "../../components/ProductHero.astro";
import reportsDesktop from "../../assets/images/desktop/screenshots/hasibu-reports-module.png";
import reportsMobile from "../../assets/images/mobile/screenshots/hasibu-report-module.png";

// Trust chips under the hero copy.
const chips = [
    { label: "Live dashboards", icon: "hugeicons:dashboard-square-02", color: "text-blue-600" },
    { label: "Filter & sort", icon: "hugeicons:filter", color: "text-teal-600" },
    { label: "Branded PDF export", icon: "hugeicons:pdf-01", color: "text-amber-500" },
    { label: "Financial statements", icon: "hugeicons:analytics-up", color: "text-green-600" },
];

// Content sourced from the real Hasibu reporting capabilities. Copy avoids em dashes by preference.
const features = [
    {
        title: "Live dashboards",
        icon: "hugeicons:dashboard-square-02",
        desc: "Top-line numbers that respond to the filters you apply, so revenue, orders and stock figures update the moment you slice the data.",
    },
    {
        title: "Filter, sort and slice",
        icon: "hugeicons:filter",
        desc: "Every report filters by date, location, product and staff, and the filters and sort you choose carry straight through to the export.",
    },
    {
        title: "Branded PDF and spreadsheet export",
        icon: "hugeicons:file-export",
        desc: "Export any list as CSV, spreadsheet or a branded PDF carrying your business name, the active filters, row count and a Powered by Hasibu footer.",
    },
    {
        title: "Financial statements",
        icon: "hugeicons:book-open-01",
        desc: "Profit and loss, balance sheet and tax reports drawn straight from the general ledger, ready for your accountant or the regulator.",
    },
    {
        title: "Per-location and consolidated",
        icon: "hugeicons:store-01",
        desc: "Read each branch on its own or the whole business rolled up, from the same report and the same numbers.",
    },
    {
        title: "Report subscriptions",
        icon: "hugeicons:mail-01",
        desc: "Subscribe to the reports that matter and have them delivered on a schedule, so the figures reach you without logging in.",
    },
];
---

<BaseLayout
    title="Reports & Analytics — Hasibu"
    description="Reporting for African SMEs. Live dashboards, filterable reports, branded PDF and spreadsheet exports, financial statements, and per-location or consolidated views."
>
    <ProductHero
        badge="Reports & Analytics"
        chips={chips}
        desktopImg={reportsDesktop}
        mobileImg={reportsMobile}
        imgAlt="Hasibu reports module: dashboards, exports and statements"
        toolbarUrl="business.hasibu.africa/reports"
    >
        <Fragment slot="title">
            Numbers you<br />
            <span class="text-brand">can act on.</span>
        </Fragment>
        <Fragment slot="blurb">
            See sales, stock and finance across every branch in one place,
            filter to the answer you need, and export it as a branded report
            in a click.
        </Fragment>
    </ProductHero>

    <!-- Features -->
    <section class="bg-white py-20 lg:py-28">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
                >
                    From raw sales to a signed-off report.
                </h2>
                <p class="mt-4 text-slate-500">
                    Every list in Hasibu is a report waiting to be filtered,
                    sorted and exported, with the same branded output across the
                    platform.
                </p>
            </div>

            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    features.map((f) => (
                        <article class="flex flex-col rounded-2xl border border-slate-100 bg-white p-6 transition hover:border-blue-100 hover:shadow-lg hover:shadow-blue-500/5">
                            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                                <Icon name={f.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                {f.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {f.desc}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        Stop exporting to spreadsheets by hand.
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href="https://app.hasibu.africa/signup"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
