---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SIGNUP_URL } from "../../lib/site";
import { Icon } from "astro-icon/components";
import GridDecor from "../../components/GridDecor.astro";
import { modules } from "../../data/modules";

// Chips frame the cross-module value (centered hero, matches the chip styling
// used in the product heroes).
const chips = [
    {
        label: "All your modules",
        icon: "hugeicons:dashboard-square-02",
        color: "text-blue-600",
    },
    {
        label: "One login",
        icon: "material-symbols:lock-outline",
        color: "text-teal-600",
    },
    {
        label: "One bill",
        icon: "material-symbols:receipt-long",
        color: "text-amber-500",
    },
    {
        label: "Every branch",
        icon: "hugeicons:location-01",
        color: "text-green-600",
    },
];
---

<BaseLayout
    title="Product — Hasibu"
    description="Every Hasibu module in one platform: POS, inventory, accounting, payroll, reports, online store, Hasibu Trade, supplier portal and integrations."
>
    <!-- Header -->
    <section
        class="relative overflow-clip bg-linear-to-b from-blue-50/70 via-white to-white pt-28 pb-12 lg:pt-36 lg:pb-16"
    >
        <GridDecor />
        <div class="relative mx-auto max-w-3xl px-6 text-center">
            <span
                class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                Platform
            </span>
            <h1
                class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-brand-dark sm:text-5xl"
            >
                One platform,<br />
                <span class="text-brand">every module you run on.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg text-slate-500">
                The same Hasibu, from the counter to the books. Explore each
                module, or see how it all fits together.
            </p>

            <div class="mt-8 flex flex-wrap justify-center gap-2.5">
                {
                    chips.map((c) => (
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600">
                            <Icon name={c.icon} class={`size-4 ${c.color}`} />
                            {c.label}
                        </span>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Modules grid (hairline dividers, grid style) -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="grid gap-px overflow-hidden rounded-2xl bg-slate-200 sm:grid-cols-2 lg:grid-cols-3"
            >
                {
                    modules.map((m) => (
                        <a
                            href={m.href}
                            class="group flex flex-col bg-white p-6 transition hover:bg-slate-50/70 lg:p-8"
                        >
                            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                                <Icon name={m.icon} class="size-6" />
                            </div>
                            <h2 class="mt-4 text-lg font-semibold text-brand-dark">
                                {m.label}
                            </h2>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {m.desc}
                            </p>
                            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand">
                                Explore module
                                <Icon
                                    name="material-symbols:arrow-forward-rounded"
                                    class="size-4 transition-transform group-hover:translate-x-0.5"
                                />
                            </span>
                        </a>
                    ))
                }

                <!-- CTA filler: fills the hanging cells of the last row. -->
                <a
                    href="/get-started/demo"
                    class="group flex flex-col justify-center bg-blue-50/60 p-6 transition hover:bg-blue-50 sm:col-span-2 lg:col-span-2 lg:p-8"
                >
                    <div
                        class="flex size-11 items-center justify-center rounded-xl bg-white text-brand"
                    >
                        <Icon
                            name="material-symbols:play-circle-outline"
                            class="size-6"
                        />
                    </div>
                    <h2 class="mt-4 text-lg font-semibold text-brand-dark">
                        See it all in two minutes
                    </h2>
                    <p class="mt-2 text-sm leading-relaxed text-slate-500">
                        A quick overview of how the modules fit together across
                        your business.
                    </p>
                    <span
                        class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand"
                    >
                        Watch overview
                        <Icon
                            name="material-symbols:arrow-forward-rounded"
                            class="size-4 transition-transform group-hover:translate-x-0.5"
                        />
                    </span>
                </a>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        See the whole platform in action
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href={SIGNUP_URL}
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
