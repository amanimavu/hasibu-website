---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import ProductHero from "../../components/ProductHero.astro";
import accountingDesktop from "../../assets/images/desktop/screenshots/accounting-module.png";
import accountingMobile from "../../assets/images/mobile/screenshots/accounting-module.png";

// Trust chips under the hero copy.
const chips = [
    {
        label: "Double-entry GL",
        icon: "hugeicons:book-open-01",
        color: "text-blue-600",
    },
    {
        label: "VAT & eTIMS",
        icon: "hugeicons:shield-energy",
        color: "text-teal-600",
    },
    { label: "Auto COGS", icon: "hugeicons:coins-01", color: "text-green-600" },
    {
        label: "Bank reconciliation",
        icon: "hugeicons:bank",
        color: "text-amber-500",
    },
];

// Content sourced from the real Hasibu accounting capabilities. Copy avoids em dashes by preference.
const features = [
    {
        title: "Double-entry general ledger",
        icon: "hugeicons:book-open-01",
        desc: "Every sale, purchase, transfer and adjustment posts to a real double-entry ledger against your chart of accounts, with no manual journals to keep.",
    },
    {
        title: "Chart of accounts",
        icon: "hugeicons:structure-01",
        desc: "Start from a ready chart and shape it to your business, with accounts wired to locations, inventory and each payment method you accept.",
    },
    {
        title: "Automatic cost of goods",
        icon: "hugeicons:coins-01",
        desc: "Cost of goods posts from your costing method, whether weighted average, FIFO or last cost, so margins are right on every sale without a spreadsheet.",
    },
    {
        title: "VAT and tax compliance",
        icon: "hugeicons:shield-energy",
        desc: "Track VAT per country and fiscalize to KRA eTIMS through Digitax, keeping returns-ready figures as you trade rather than at month end.",
    },
    {
        title: "Bank reconciliation",
        icon: "hugeicons:bank",
        desc: "Match statements against recorded transactions and clear the differences, so cash on the books always matches cash in the bank.",
    },
    {
        title: "Financial statements and reports",
        icon: "hugeicons:analytics-up",
        desc: "Produce profit and loss, balance sheet and tax reports on demand, exported as a branded PDF or spreadsheet for your accountant or the regulator.",
    },
];
---

<BaseLayout
    title="Accounting & GL — Hasibu"
    description="Double-entry accounting for African SMEs. General ledger, chart of accounts, automatic COGS, VAT and KRA eTIMS compliance, bank reconciliation, and financial statements."
>
    <ProductHero
        badge="Accounting & GL"
        chips={chips}
        desktopImg={accountingDesktop}
        mobileImg={accountingMobile}
        imgAlt="Hasibu accounting module: general ledger, VAT, COGS and bank reconciliation"
        toolbarUrl="business.hasibu.africa/accounting"
    >
        <Fragment slot="title">
            Books that keep<br />
            <span class="text-brand">themselves.</span>
        </Fragment>
        <Fragment slot="blurb">
            Every sale, purchase and transfer posts double-entry to your general
            ledger, with VAT, cost of goods and bank reconciliation handled as
            you trade.
        </Fragment>
    </ProductHero>

    <!-- Features -->
    <section class="bg-slate-100 py-20 lg:py-28">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
                >
                    Compliance without the late nights
                </h2>
                <p class="mt-4 text-slate-500">
                    The ledger updates itself as you sell, so your accountant
                    reviews numbers instead of rebuilding them.
                </p>
            </div>

            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    features.map((f) => (
                        <article class="flex flex-col rounded-2xl bg-slate-100 p-6 shadow-[6px_6px_12px_#c9cfdd,-6px_-6px_12px_#ffffff] transition hover:shadow-[8px_8px_16px_#c2c9d9,-8px_-8px_16px_#ffffff]">
                            <div class="flex size-11 items-center justify-center rounded-xl bg-slate-100 text-brand shadow-[inset_3px_3px_6px_#c9cfdd,inset_-3px_-3px_6px_#ffffff]">
                                <Icon name={f.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                {f.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {f.desc}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white py-10 lg:py-14">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        Close your books in minutes, not days.
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href="https://app.hasibu.africa/signup"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
