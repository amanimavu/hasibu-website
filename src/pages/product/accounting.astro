---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

// Trust chips under the hero copy.
const chips = [
    { label: "Double-entry GL", icon: "hugeicons:book-open-01", color: "text-blue-600" },
    { label: "VAT & eTIMS", icon: "hugeicons:shield-energy", color: "text-teal-600" },
    { label: "Auto COGS", icon: "hugeicons:coins-01", color: "text-green-600" },
    { label: "Bank reconciliation", icon: "hugeicons:bank", color: "text-amber-500" },
];

// Content sourced from the real Hasibu accounting capabilities. Copy avoids em dashes by preference.
const features = [
    {
        title: "Double-entry general ledger",
        icon: "hugeicons:book-open-01",
        desc: "Every sale, purchase, transfer and adjustment posts to a real double-entry ledger against your chart of accounts, with no manual journals to keep.",
    },
    {
        title: "Chart of accounts",
        icon: "hugeicons:structure-01",
        desc: "Start from a ready chart and shape it to your business, with accounts wired to locations, inventory and each payment method you accept.",
    },
    {
        title: "Automatic cost of goods",
        icon: "hugeicons:coins-01",
        desc: "Cost of goods posts from your costing method, whether weighted average, FIFO or last cost, so margins are right on every sale without a spreadsheet.",
    },
    {
        title: "VAT and tax compliance",
        icon: "hugeicons:shield-energy",
        desc: "Track VAT per country and fiscalize to KRA eTIMS through Digitax, keeping returns-ready figures as you trade rather than at month end.",
    },
    {
        title: "Bank reconciliation",
        icon: "hugeicons:bank",
        desc: "Match statements against recorded transactions and clear the differences, so cash on the books always matches cash in the bank.",
    },
    {
        title: "Financial statements and reports",
        icon: "hugeicons:analytics-up",
        desc: "Produce profit and loss, balance sheet and tax reports on demand, exported as a branded PDF or spreadsheet for your accountant or the regulator.",
    },
];
---

<BaseLayout
    title="Accounting & GL — Hasibu"
    description="Double-entry accounting for African SMEs. General ledger, chart of accounts, automatic COGS, VAT and KRA eTIMS compliance, bank reconciliation, and financial statements."
>
    <!-- Hero -->
    <section
        class="relative overflow-clip bg-linear-60 from-[#F8FAFC] from-0% via-[#FFFFFF] via-50% to-[#EFF6FF]/40 to-100% flex min-h-screen lg:flex-col lg:justify-center lg:pt-20"
    >
        <div
            class="absolute aspect-square w-96 -right-20 -top-48 rounded-full bg-[#DBEAFE]/15 blur-xl"
        >
        </div>
        <div
            class="mx-auto grid w-full max-w-6xl items-center gap-12 px-6 pt-28 pb-16 lg:grid-cols-2 lg:gap-20 lg:py-12"
        >
            <!-- Copy -->
            <div>
                <span
                    class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
                >
                    <span class="size-1.5 rounded-full bg-brand"></span>
                    Accounting & GL
                </span>

                <h1
                    class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-brand-dark sm:text-5xl lg:text-6xl"
                >
                    Books that keep<br />
                    <span class="text-brand">themselves.</span>
                </h1>

                <p class="mt-6 max-w-lg text-lg text-slate-500">
                    Every sale, purchase and transfer posts double-entry to your
                    general ledger, with VAT, cost of goods and bank
                    reconciliation handled as you trade.
                </p>

                <div class="mt-6 flex flex-wrap gap-2.5">
                    {
                        chips.map((c) => (
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600">
                                <Icon name={c.icon} class={`size-4 ${c.color}`} />
                                {c.label}
                            </span>
                        ))
                    }
                </div>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a
                        href="/get-started/signup"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 font-medium text-slate-700 transition hover:border-brand hover:text-brand"
                    >
                        <Icon
                            name="material-symbols:play-circle-outline"
                            class="size-5"
                        />
                        Book a Demo
                    </a>
                </div>
            </div>

            <!-- Placeholder screenshot (swap for a real Hasibu accounting image later) -->
            <div class="lg:justify-self-end">
                <div
                    class="w-full max-w-xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl"
                >
                    <div
                        class="flex items-center gap-1.5 border-b border-slate-100 px-4 py-3"
                    >
                        <span class="size-3 rounded-full bg-red-400"></span>
                        <span class="size-3 rounded-full bg-amber-400"></span>
                        <span class="size-3 rounded-full bg-green-400"></span>
                        <span class="ml-3 text-xs text-slate-400">
                            app.hasibu.africa/accounting
                        </span>
                    </div>
                    <img
                        src="https://placehold.co/600x400"
                        alt="Hasibu accounting screenshot placeholder"
                        width="600"
                        height="400"
                        loading="eager"
                        class="aspect-[4/3] w-full object-cover"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section class="bg-white py-20 lg:py-28">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
                >
                    Compliance without the late nights.
                </h2>
                <p class="mt-4 text-slate-500">
                    The ledger updates itself as you sell, so your accountant
                    reviews numbers instead of rebuilding them.
                </p>
            </div>

            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    features.map((f) => (
                        <article class="flex flex-col rounded-2xl border border-slate-100 bg-white p-6 transition hover:border-blue-100 hover:shadow-lg hover:shadow-blue-500/5">
                            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                                <Icon name={f.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                {f.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {f.desc}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        Close your books in minutes, not days.
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href="/get-started/signup"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
