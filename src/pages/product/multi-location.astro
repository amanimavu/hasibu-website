---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import ProductHero from "../../components/ProductHero.astro";
import MultiLocationFlow from "../../components/MultiLocationFlow.astro";

// Trust chips under the hero copy.
const chips = [
    {
        label: "Shops & stores",
        icon: "hugeicons:store-01",
        color: "text-blue-600",
    },
    {
        label: "Per-location stock",
        icon: "hugeicons:package",
        color: "text-teal-600",
    },
    {
        label: "Stock transfers",
        icon: "hugeicons:arrow-data-transfer-horizontal",
        color: "text-amber-500",
    },
    {
        label: "Consolidated reports",
        icon: "hugeicons:analytics-up",
        color: "text-green-600",
    },
];

// Content sourced from the real Hasibu location model. Copy avoids em dashes by preference.
const features = [
    {
        title: "Shops and stores",
        icon: "hugeicons:store-01",
        desc: "Model each branch as a shop that sells at the POS or a store that only holds stock. Every location carries its own on-hand, pricing destination and inventory account.",
    },
    {
        title: "Transfers between branches",
        icon: "hugeicons:arrow-data-transfer-horizontal",
        desc: "Move goods from a store to a shop, or branch to branch, with tracked transfers so every location's on-hand figure stays honest.",
    },
    {
        title: "Retail and wholesale side by side",
        icon: "hugeicons:sale-tag-02",
        desc: "Flag a location as wholesale and route the right price list, so your retail counter and trade counter can run from the same business.",
    },
    {
        title: "Routed receipts and tickets",
        icon: "hugeicons:printer",
        desc: "Each location prints to its own receipt and kitchen printers, with restaurant tables mapped per branch for hospitality floors.",
    },
    {
        title: "Staff and roles per location",
        icon: "hugeicons:user-group",
        desc: "Assign staff, permissions and the Served-by flow at the branch where they actually work, so access matches the floor.",
    },
    {
        title: "Consolidated reporting",
        icon: "hugeicons:dashboard-square-02",
        desc: "Read sales, stock and finance per branch, or rolled up across the whole business, from a single set of reports.",
    },
];
---

<BaseLayout
    title="Multi-Location — Hasibu"
    description="Run every shop and store under one Hasibu business. Per-location stock, transfers, retail and wholesale pricing, routed printing, and consolidated reporting."
>
    <ProductHero
        badge="Multi-Location"
        chips={chips}
        imgAlt="Hasibu multi-location: shops, stores, transfers and consolidated reports"
        toolbarUrl="business.hasibu.africa/locations"
    >
        <Fragment slot="title">
            One business,<br />
            <span class="text-brand">every branch in sync.</span>
        </Fragment>
        <Fragment slot="blurb">
            Run all your shops and stores under one Hasibu business, with
            per-location stock, pricing, printing and staff that still roll up
            to a single view of the whole company.
        </Fragment>
        <MultiLocationFlow slot="graphic" />
    </ProductHero>

    <!-- Features -->
    <section class="bg-slate-100 py-20 lg:py-28">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
                >
                    Built to grow branch by branch
                </h2>
                <p class="mt-4 text-slate-500">
                    Add a location, not a new system. Each branch runs its own
                    floor while the business keeps one source of truth.
                </p>
            </div>

            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    features.map((f) => (
                        <article class="flex flex-col rounded-2xl bg-slate-100 p-6 shadow-[6px_6px_12px_#c9cfdd,-6px_-6px_12px_#ffffff] transition hover:shadow-[8px_8px_16px_#c2c9d9,-8px_-8px_16px_#ffffff]">
                            <div class="flex size-11 items-center justify-center rounded-xl bg-slate-100 text-brand shadow-[inset_3px_3px_6px_#c9cfdd,inset_-3px_-3px_6px_#ffffff]">
                                <Icon name={f.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                {f.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {f.desc}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white py-10 lg:py-14">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        Ready to open your next branch?
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href="https://app.hasibu.africa/signup"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
