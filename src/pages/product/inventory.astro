---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import ProductHero from "../../components/ProductHero.astro";
import inventoryDesktop from "../../assets/images/desktop/screenshots/hasibu-inventory-module.png";
import inventoryMobile from "../../assets/images/mobile/screenshots/hasibu-inventory-module.png";

// Trust chips under the hero copy.
const chips = [
    {
        label: "Real-time ledger",
        icon: "hugeicons:refresh",
        color: "text-blue-600",
    },
    {
        label: "Batch & expiry",
        icon: "hugeicons:calendar-03",
        color: "text-amber-500",
    },
    {
        label: "Multi-location",
        icon: "hugeicons:location-01",
        color: "text-teal-600",
    },
    {
        label: "WAC / FIFO / last cost",
        icon: "hugeicons:coins-01",
        color: "text-green-600",
    },
];

// Content sourced from the real Hasibu inventory capabilities. Copy avoids em dashes by preference.
const features = [
    {
        title: "Real-time stock ledger",
        icon: "hugeicons:chart-line-data-01",
        desc: "Every receive, sale, transfer, adjustment and production run posts to a live ledger. See on-hand, committed and incoming quantities per location at any moment.",
    },
    {
        title: "Batch and expiry tracking",
        icon: "hugeicons:calendar-03",
        desc: "Track expiry per batch with shelf-life rules, so pharmacies, supermarkets and food businesses move the right stock first and cut write-offs.",
    },
    {
        title: "Variants and units",
        icon: "hugeicons:layers-01",
        desc: "Sell one product in sizes, colours and packs, with units of measure that convert between how you buy and how you sell.",
    },
    {
        title: "Multi-location transfers",
        icon: "hugeicons:arrow-data-transfer-horizontal",
        desc: "Move stock between shops and stores with tracked transfers, and keep each location's on-hand figure honest as goods change hands.",
    },
    {
        title: "Your costing method",
        icon: "hugeicons:coins-01",
        desc: "Value stock by weighted average, FIFO or last cost per business. Every sale then posts the right cost of goods to your books automatically.",
    },
    {
        title: "Receiving, adjustments and production",
        icon: "hugeicons:package-process",
        desc: "Receive against delivery notes, adjust for stock counts and breakage, and build finished goods from raw inputs, all posted straight to the ledger.",
    },
];
---

<BaseLayout
    title="Inventory & Stock — Hasibu"
    description="Real-time inventory for African SMEs. Stock ledger, batch and expiry tracking, variants, multi-location transfers, and WAC, FIFO or last-cost valuation."
>
    <ProductHero
        badge="Inventory & Stock"
        chips={chips}
        desktopImg={inventoryDesktop}
        mobileImg={inventoryMobile}
        imgAlt="Hasibu inventory module: stock ledger, batches and transfers"
        toolbarUrl="business.hasibu.africa/inventory"
    >
        <Fragment slot="title">
            Stock you can trust,<br />
            <span class="text-brand">down to the last unit.</span>
        </Fragment>
        <Fragment slot="blurb">
            Hasibu tracks every unit across your shops and stores in real time,
            with batch and expiry, variants, transfers and the costing method
            your business runs on.
        </Fragment>
    </ProductHero>

    <!-- Features -->
    <section class="bg-slate-100 py-20 lg:py-28">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
                >
                    Always know what you have
                </h2>
                <p class="mt-4 text-slate-500">
                    One stock ledger across every location, built for the way
                    African retail, wholesale and food businesses move goods.
                </p>
            </div>

            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    features.map((f) => (
                        <article class="flex flex-col rounded-2xl bg-slate-100 p-6 shadow-[6px_6px_12px_#c9cfdd,-6px_-6px_12px_#ffffff] transition hover:shadow-[8px_8px_16px_#c2c9d9,-8px_-8px_16px_#ffffff]">
                            <div class="flex size-11 items-center justify-center rounded-xl bg-slate-100 text-brand shadow-[inset_3px_3px_6px_#c9cfdd,inset_-3px_-3px_6px_#ffffff]">
                                <Icon name={f.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                {f.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {f.desc}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white py-10 lg:py-14">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        Stop guessing your stock
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href="https://app.hasibu.africa/signup"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
