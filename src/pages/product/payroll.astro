---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import payrollDesktop from "../../assets/images/desktop/screenshots/hasibu-payroll-module.png";
import payrollMobile from "../../assets/images/mobile/screenshots/hasibu-payroll-module.png";

const chips = [
    {
        label: "PAYE, NHIF & NSSF",
        icon: "hugeicons:shield-energy",
        color: "text-teal-600",
    },
    { label: "Payslips", icon: "hugeicons:invoice-03", color: "text-blue-600" },
    {
        label: "Commissions",
        icon: "hugeicons:analytics-up",
        color: "text-green-600",
    },
    {
        label: "Advances & loans",
        icon: "hugeicons:money-bag-02",
        color: "text-amber-500",
    },
];

// Content sourced from the real Hasibu Payroll module. Copy avoids em dashes by preference.
const features = [
    {
        title: "Employee salaries",
        icon: "hugeicons:wallet-01",
        desc: "Process monthly and weekly salary runs for every employee, on one screen.",
    },
    {
        title: "Payroll runs and payslips",
        icon: "hugeicons:invoice-03",
        desc: "Run payroll in a few clicks and generate payslips for your team automatically.",
    },
    {
        title: "Allowances and deductions",
        icon: "hugeicons:calculator",
        desc: "Transport, housing, NSSF, NHIF and PAYE are applied on every run, so statutory figures stay right.",
    },
    {
        title: "Commissions",
        icon: "hugeicons:analytics-up",
        desc: "Track and pay sales commissions per employee, with rules set per employee, product or category.",
    },
    {
        title: "Advances and loans",
        icon: "hugeicons:piggy-bank",
        desc: "Manage salary advance requests and track employee loans and repayments alongside payroll.",
    },
    {
        title: "Payroll periods",
        icon: "hugeicons:calendar-03",
        desc: "Define the pay windows that group your payroll runs, weekly or monthly.",
    },
];
---

<BaseLayout
    title="Payroll — Hasibu"
    description="Run payroll for African SMEs. Salary runs, payslips, PAYE, NHIF and NSSF deductions, commissions, salary advances and employee loans, all in one place."
>
    <!-- Hero -->
    <section
        class="relative overflow-clip bg-linear-60 from-[#F8FAFC] from-0% via-[#FFFFFF] via-50% to-[#EFF6FF]/40 to-100% pt-28 pb-20 lg:min-h-screen lg:pt-20 lg:pb-24"
    >
        <div
            class="absolute aspect-square w-96 -right-20 -top-48 rounded-full bg-[#DBEAFE]/15 blur-xl"
        >
        </div>

        <!-- Copy (centered) -->
        <div class="relative z-10 ml-auto max-w-3xl px-6 p-15">
            <!-- Faded white panel behind the text (top/bottom/right dissolve) -->
            <div
                class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-r from-white from-0% to-transparent to-100% backdrop-blur-lg mask-(--hero-mask) mask-intersect [-webkit-mask-image:var(--hero-mask)] [-webkit-mask-composite:source-in]"
            >
            </div>

            <span
                class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                Payroll
            </span>

            <h1
                class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-brand-dark sm:text-5xl lg:text-6xl"
            >
                Pay your team,<br />
                <span class="text-brand">down to the deduction.</span>
            </h1>

            <p class="mt-6 max-w-xl text-lg text-slate-500">
                Run salaries, generate payslips, and handle PAYE, NHIF and NSSF,
                plus commissions, advances and loans, all from one place inside
                Hasibu.
            </p>

            <div class="mt-6 flex flex-wrap gap-2.5">
                {
                    chips.map((c) => (
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600">
                            <Icon name={c.icon} class={`size-4 ${c.color}`} />
                            {c.label}
                        </span>
                    ))
                }
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a
                    href="https://app.hasibu.africa/signup"
                    class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90"
                >
                    Start Free Trial
                </a>
                <a
                    href="/get-started/demo"
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 font-medium text-slate-700 transition hover:border-brand hover:text-brand"
                >
                    <Icon
                        name="material-symbols:play-circle-outline"
                        class="size-5"
                    />
                    Book a Demo
                </a>
            </div>
        </div>

        <!-- Real payroll module screenshot (large, framed) -->
        <div class="absolute top-20 z-9 mt-14 max-w-5xl px-6 lg:mt-20">
            <!-- Desktop: framed in a browser chrome -->
            <div
                class="hidden overflow-hidden rounded-2xl border border-slate-200 shadow-2xl sm:block ml-10"
            >
                <div
                    class="flex items-center gap-1.5 border-b border-slate-100 bg-white px-4 py-3"
                >
                    <span class="size-3 rounded-full bg-red-400"></span>
                    <span class="size-3 rounded-full bg-amber-400"></span>
                    <span class="size-3 rounded-full bg-green-400"></span>
                    <span class="ml-3 text-xs text-slate-400">
                        business.hasibu.africa/finance/payroll
                    </span>
                </div>
                <Image
                    src={payrollDesktop}
                    alt="Hasibu payroll module: salaries, commissions, advances and payroll runs"
                    class="w-full"
                    loading="eager"
                />
            </div>

            <!-- Mobile -->
            <Image
                src={payrollMobile}
                alt="Hasibu payroll module on mobile"
                class="mx-auto w-full max-w-75 rounded-2xl border border-slate-200 shadow-xl sm:hidden"
                loading="eager"
            />
        </div>
    </section>

    <!-- Features -->
    <section class="bg-white py-20 lg:py-28">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
                >
                    Payday without the headache.
                </h2>
                <p class="mt-4 text-slate-500">
                    From salaries to statutory deductions, Hasibu runs payroll
                    the way African SMEs actually pay their people.
                </p>
            </div>

            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    features.map((f) => (
                        <article class="flex flex-col rounded-2xl border border-slate-100 bg-white p-6 transition hover:border-blue-100 hover:shadow-lg hover:shadow-blue-500/5">
                            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                                <Icon name={f.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                {f.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {f.desc}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        Run your next payroll on Hasibu.
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href="https://app.hasibu.africa/signup"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
