---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import posShot from "../../assets/images/desktop/pos_screenshot.png";

// Trust chips shown under the hero copy.
const chips = [
    {
        label: "Real-time sync",
        icon: "hugeicons:refresh",
        color: "text-blue-600",
    },
    {
        label: "M-Pesa native",
        icon: "hugeicons:smart-phone-01",
        color: "text-green-600",
    },
    {
        label: "KRA ETR compliant",
        icon: "hugeicons:shield-energy",
        color: "text-teal-600",
    },
    {
        label: "Card & mobile money",
        icon: "hugeicons:credit-card",
        color: "text-blue-600",
    },
];

// Content sourced from the real Hasibu POS capabilities. Copy avoids em dashes by preference.
const features = [
    {
        title: "Mobile money built in",
        icon: "hugeicons:smart-phone-01",
        desc: "M-Pesa Daraja, Airtel Money and MTN MoMo sit right beside card and cash on one checkout screen. The cashier picks a method, the customer pays, and the sale closes without ever leaving the till.",
    },
    {
        title: "Tabs and tables",
        icon: "hugeicons:dining-table",
        desc: "Open a tab per table, move guests as they shift seats, and split, merge or transfer bills as the night changes. Built for cafes, bars and restaurants where one order rarely stays in one place.",
    },
    {
        title: "Served-by attribution",
        icon: "hugeicons:user-multiple",
        desc: "Post a sale on behalf of another staff member with the permissioned Served-by picker, so commission and accountability land on the right person. Once the sale is saved, the server is locked in.",
    },
    {
        title: "Thermal receipts",
        icon: "hugeicons:printer",
        desc: "Receipts route to the right printer for each shop or store automatically, with no fiddling per device. Kitchen tickets and customer receipts always go where they are meant to.",
    },
    {
        title: "Built for thin connections",
        icon: "hugeicons:no-internet",
        desc: "Cached product and price reads keep the counter moving when the line wobbles. Everything reconciles back to your books the moment the connection returns.",
    },
    {
        title: "Permissioned actions",
        icon: "hugeicons:shield-user",
        desc: "Split, merge, comp, void and discount are each gated by their own staff permission. Managers approve the sensitive actions while cashiers keep the queue moving.",
    },
];
---

<BaseLayout
    title="Point of Sale — Hasibu"
    description="A fast point of sale for African retail and hospitality. Cash, card, M-Pesa, Airtel Money and MTN MoMo, thermal printing, and offline-tolerant checkout."
>
    <!-- Hero -->
    <section
        class="relative overflow-clip bg-linear-60 from-[#F8FAFC] from-0% via-[#FFFFFF] via-50% to-[#EFF6FF]/40 to-100% flex min-h-screen lg:flex-col lg:justify-center lg:pt-20"
    >
        <div
            class="absolute aspect-square w-96 -right-20 -top-48 rounded-full bg-[#DBEAFE]/15 blur-xl"
        >
        </div>
        <div
            class="absolute aspect-square w-48 -left-10 top-[85%] rounded-full bg-[#DBEAFE]/20 blur-xl"
        >
        </div>
        <div
            class="mx-auto grid w-full max-w-6xl items-center gap-12 px-6 pt-28 pb-16 lg:grid-cols-2 lg:py-12"
        >
            <!-- Copy -->
            <div>
                <span
                    class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
                >
                    <span class="size-1.5 rounded-full bg-brand"></span>
                    Hasibu Point of Sale · v4.2
                </span>

                <h1
                    class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-brand-dark sm:text-5xl lg:text-6xl"
                >
                    Sell faster,<br />
                    <span class="text-brand">get paid instantly.</span>
                </h1>

                <p class="mt-6 max-w-lg text-lg text-slate-500">
                    Hasibu POS gives retail and hospitality a blazing-fast
                    checkout, with M-Pesa, Airtel Money, MTN MoMo, card and cash
                    settled on one screen and synced to your books in real time.
                </p>

                <div class="mt-6 flex flex-wrap gap-2.5">
                    {
                        chips.map((c) => (
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600">
                                <Icon
                                    name={c.icon}
                                    class={`size-4 ${c.color}`}
                                />
                                {c.label}
                            </span>
                        ))
                    }
                </div>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        <Icon name="hugeicons:calendar-03" class="size-5" />
                        Book a Free Demo
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 font-medium text-slate-700 transition hover:border-brand hover:text-brand"
                    >
                        <Icon
                            name="material-symbols:play-circle-outline"
                            class="size-5"
                        />
                        Watch 2-min Tour
                    </a>
                </div>
            </div>

            <!-- Device shot with floating status cards -->
            <div class="relative lg:justify-self-end">
                <Image
                    src={posShot}
                    alt="Hasibu POS running offline on a tablet, with M-Pesa, Airtel, Cash, Card and MTN payment options"
                    class="w-full max-w-xl"
                    loading="eager"
                />

                <!-- M-Pesa settled (top right) -->
                <div
                    class="absolute -top-3 right-0 hidden items-center gap-2.5 rounded-xl border border-slate-100 bg-white px-4 py-3 shadow-lg sm:flex lg:-right-4"
                >
                    <span
                        class="flex size-9 items-center justify-center rounded-lg bg-green-50 text-green-600"
                    >
                        <Icon name="hugeicons:smart-phone-01" class="size-5" />
                    </span>
                    <span class="text-sm">
                        <span class="block font-semibold text-brand-dark">
                            M-Pesa Settled
                        </span>
                        <span class="text-xs text-green-600">
                            KES 12,450 · instant
                        </span>
                    </span>
                </div>

                <!-- Live sync (bottom left) -->
                <div
                    class="absolute -bottom-3 left-0 hidden items-center gap-2.5 rounded-xl border border-slate-100 bg-white px-4 py-3 shadow-lg sm:flex lg:-left-4"
                >
                    <span
                        class="flex size-9 items-center justify-center rounded-lg bg-blue-50 text-brand"
                    >
                        <Icon name="hugeicons:refresh" class="size-5" />
                    </span>
                    <span class="text-sm">
                        <span class="block font-semibold text-brand-dark">
                            Synced to cloud
                        </span>
                        <span class="text-xs text-slate-400">
                            Books updated in real time
                        </span>
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section class="bg-white py-20 lg:py-28">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
                >
                    Everything the counter needs.
                </h2>
                <p class="mt-4 text-slate-500">
                    One screen for payments, tabs, staff and printing, built for
                    African retail and hospitality.
                </p>
            </div>

            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    features.map((f) => (
                        <article class="flex flex-col rounded-2xl border border-slate-100 bg-white p-6 transition hover:border-blue-100 hover:shadow-lg hover:shadow-blue-500/5">
                            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                                <Icon name={f.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                {f.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {f.desc}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        Ready to speed up your checkout?
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href="https://app.hasibu.africa/signup"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
