---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import GridDecor from "../../components/GridDecor.astro";
import { industries, roles } from "../../data/solutions";

const axes = [
    {
        title: "By industry",
        subtitle: "Built for how your sector trades",
        list: industries,
        icon: "hugeicons:store-01",
        ctaTitle: "Don't see your sector?",
        ctaDesc: "Tell us how you trade and we will show you how Hasibu fits.",
        ctaLink: "Talk to us",
        ctaHref: "/company/contact",
    },
    {
        title: "By role",
        subtitle: "However you spend your day",
        list: roles,
        icon: "hugeicons:user-group",
        ctaTitle: "Not sure which fits?",
        ctaDesc: "Book a quick demo and we will tailor it to how you work.",
        ctaLink: "Book a demo",
        ctaHref: "/get-started/demo",
    },
];
---

<BaseLayout
    title="Solutions — Hasibu"
    description="Hasibu for your business. Solutions by industry (retail, restaurant, wholesale, manufacturing, services, supermarket, pharmacy) and by role (owner, cashier, accountant, distributor)."
>
    <!-- Hero -->
    <section
        class="relative overflow-clip bg-linear-to-b from-blue-50/70 via-white to-white pt-28 pb-12 lg:pt-36 lg:pb-16"
    >
        <GridDecor />
        <div class="relative mx-auto max-w-3xl px-6 text-center">
            <span
                class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                Solutions
            </span>
            <h1
                class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-brand-dark sm:text-5xl"
            >
                One platform,<br />
                <span class="text-brand">shaped to your business.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg text-slate-500">
                The same Hasibu, framed for the way your sector trades and the
                job you do every day.
            </p>
        </div>
    </section>

    <!-- Axes -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl space-y-16 px-6">
            {
                axes.map((axis) => {
                    // Fill the last row's empty cells with the CTA tile. Hanging
                    // cells differ per breakpoint, so size the CTA from the
                    // count: show it only where there is a gap, spanning it.
                    const len = axis.list.length;
                    const eSm = (2 - (len % 2)) % 2;
                    const eLg = (3 - (len % 3)) % 3;
                    const ctaCls = [
                        "hidden",
                        eSm > 0 ? "sm:flex" : "sm:hidden",
                        eLg > 0 ? "lg:flex" : "lg:hidden",
                        eLg === 2 ? "lg:col-span-2" : "",
                    ].join(" ");
                    return (
                        <div>
                            <div class="flex items-baseline justify-between gap-4">
                                <h2 class="text-2xl font-bold tracking-tight text-brand-dark">
                                    {axis.title}
                                </h2>
                                <span class="text-sm text-slate-400">
                                    {axis.subtitle}
                                </span>
                            </div>
                            <div class="mt-6 grid gap-px overflow-hidden rounded-2xl bg-slate-200 sm:grid-cols-2 lg:grid-cols-3">
                                {axis.list.map((s) => (
                                    <a
                                        href={`/solutions/${s.slug}`}
                                        class="group flex flex-col bg-white p-6 transition hover:bg-slate-50/70 lg:p-8"
                                    >
                                        <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                                            <Icon name={s.icon} class="size-6" />
                                        </div>
                                        <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                            {s.name}
                                        </h3>
                                        <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                            {s.tagline}
                                        </p>
                                        <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand">
                                            Explore
                                            <Icon
                                                name="material-symbols:arrow-forward-rounded"
                                                class="size-4 transition-transform group-hover:translate-x-0.5"
                                            />
                                        </span>
                                    </a>
                                ))}

                                {/* CTA filler: completes the last row */}
                                <a
                                    href={axis.ctaHref}
                                    class={`group flex-col justify-center bg-blue-50/60 p-6 transition hover:bg-blue-50 lg:p-8 ${ctaCls}`}
                                >
                                    <div class="flex size-11 items-center justify-center rounded-xl bg-white text-brand">
                                        <Icon name={axis.icon} class="size-6" />
                                    </div>
                                    <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                        {axis.ctaTitle}
                                    </h3>
                                    <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                        {axis.ctaDesc}
                                    </p>
                                    <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand">
                                        {axis.ctaLink}
                                        <Icon
                                            name="material-symbols:arrow-forward-rounded"
                                            class="size-4 transition-transform group-hover:translate-x-0.5"
                                        />
                                    </span>
                                </a>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </section>
</BaseLayout>
