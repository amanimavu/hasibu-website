---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SIGNUP_URL } from "../../lib/site";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { allSolutions } from "../../data/solutions";

export function getStaticPaths() {
    return allSolutions.map((s) => ({
        params: { slug: s.slug },
        props: { solution: s },
    }));
}

const { solution } = Astro.props;
const axisLabel = solution.axis === "industry" ? "By industry" : "By role";

// Hero media, keyed by solution slug. Two optional sources, video wins:
//   video: src/assets/videos/<slug>-video-explainer.webm
//   image: src/assets/images/solutions/<slug>.{jpg,jpeg,png,webp}  (a real
//          scene photo, shown frameless)
// If neither exists, a plain placeholder renders.
const videoModules = import.meta.glob<string>(
    "../../assets/videos/*-video-explainer.webm",
    { eager: true, query: "?url", import: "default" },
);
const videoMap: Record<string, string> = {};
for (const [path, url] of Object.entries(videoModules)) {
    const file = path.split("/").pop()!;
    videoMap[file.replace("-video-explainer.webm", "")] = url;
}
const videoSrc = videoMap[solution.slug];

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/images/solutions/*.{jpg,jpeg,png,webp}",
    { eager: true },
);
const imageMap: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
    const file = path.split("/").pop()!;
    const slug = file.replace(/\.(jpe?g|png|webp)$/i, "");
    imageMap[slug] = mod.default;
}
const imageSrc = imageMap[solution.slug];

// Small app-style callout floated over the hero media, tying the real scene
// back to Hasibu. Only shown when the solution defines one.
const heroCallout = solution.callout;
const calloutTone = {
    green: "bg-green-50 text-green-600",
    blue: "bg-blue-50 text-brand",
    amber: "bg-amber-50 text-amber-600",
}[heroCallout?.tone ?? "green"];
---

<BaseLayout title={`Hasibu for ${solution.name}`} description={solution.intro}>
    <!-- Hero -->
    <section
        class="relative overflow-clip bg-linear-60 from-[#F8FAFC] from-0% via-[#FFFFFF] via-50% to-[#EFF6FF]/40 to-100% flex min-h-screen lg:flex-col lg:justify-center lg:pt-20"
    >
        <div
            class="absolute aspect-square w-96 -right-20 -top-48 rounded-full bg-[#DBEAFE]/15 blur-xl"
        >
        </div>
        <div
            class="mx-auto grid w-full max-w-7xl items-center gap-12 px-6 pt-28 pb-16 lg:grid-cols-[1fr_1.25fr] lg:gap-16 lg:py-12"
        >
            <!-- Copy -->
            <div>
                <span
                    class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
                >
                    <Icon name={solution.icon} class="size-3.5" />
                    Solutions · {axisLabel}
                </span>

                <h1
                    class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-brand-dark sm:text-5xl lg:text-6xl"
                >
                    Hasibu for<br />
                    <span class="text-brand">{solution.name}.</span>
                </h1>

                <p class="mt-6 max-w-lg text-lg text-slate-500">
                    {solution.intro}
                </p>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a
                        href={SIGNUP_URL}
                        class="group inline-flex items-center justify-center gap-2 rounded-lg bg-brand px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                        <Icon
                            name="material-symbols:arrow-forward-rounded"
                            class="size-5 transition-transform group-hover:translate-x-0.5"
                        />
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 font-medium text-slate-700 transition hover:border-brand hover:text-brand"
                    >
                        <Icon
                            name="material-symbols:play-circle-outline"
                            class="size-5"
                        />
                        Book a Demo
                    </a>
                </div>
                <p class="mt-4 text-sm text-slate-400">
                    14-day free trial. No credit card required.
                </p>
            </div>

            <!-- Hero media: explainer video, else a real scene photo (frameless),
                 else a plain placeholder. -->
            <div class="relative lg:justify-self-end">
                {videoSrc ? (
                    <div class="w-full max-w-2xl overflow-hidden rounded-2xl bg-slate-900 shadow-2xl ring-1 ring-black/5 lg:max-w-none">
                        <video
                            class="aspect-video w-full object-cover"
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            aria-label={`Hasibu for ${solution.name} explainer video`}
                        >
                            <source src={videoSrc} type="video/webm" />
                        </video>
                    </div>
                ) : imageSrc ? (
                    <Image
                        src={imageSrc}
                        alt={`Hasibu for ${solution.name}`}
                        class="aspect-4/3 w-full rounded-2xl object-cover shadow-xl ring-1 ring-black/5 lg:max-w-none"
                        width={1024}
                        densities={[1, 2]}
                        priority
                    />
                ) : (
                    <div class="flex aspect-4/3 w-full items-center justify-center rounded-2xl bg-slate-100 text-slate-300 ring-1 ring-slate-200">
                        <Icon name={solution.icon} class="size-16" />
                    </div>
                )}

                {(videoSrc || imageSrc) && heroCallout && (
                    <div class="absolute -bottom-4 -left-4 hidden items-center gap-3 rounded-xl bg-white p-3 shadow-xl ring-1 ring-slate-200 sm:flex">
                        <span class={`flex size-9 items-center justify-center rounded-lg ${calloutTone}`}>
                            <Icon name={heroCallout.icon} class="size-5" />
                        </span>
                        <div class="leading-tight">
                            <p class="text-xs font-semibold text-brand-dark">
                                {heroCallout.line1}
                            </p>
                            <p class="text-[11px] text-slate-400">
                                {heroCallout.line2}
                            </p>
                        </div>
                    </div>
                )}
            </div>
        </div>
    </section>

    <!-- Tailored points -->
    <section class="bg-white py-20 lg:py-28">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
                >
                    What {solution.name} get from Hasibu.
                </h2>
                <p class="mt-4 text-slate-500">
                    The modules that matter most, ready out of the box.
                </p>
            </div>

            <div class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-slate-200 sm:grid-cols-2">
                {
                    solution.points.map((p) => (
                        <a
                            href={p.href}
                            class="group flex flex-col bg-white p-6 transition hover:bg-slate-50/70 lg:p-8"
                        >
                            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                                <Icon name={p.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 inline-flex items-center gap-1 text-lg font-semibold text-brand-dark">
                                {p.title}
                                <Icon
                                    name="material-symbols:arrow-forward-rounded"
                                    class="size-4 text-slate-300 transition-transform group-hover:translate-x-0.5 group-hover:text-brand"
                                />
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {p.desc}
                            </p>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
            >
                <div>
                    <h2 class="text-2xl font-bold text-brand-dark">
                        See Hasibu for {solution.name.toLowerCase()}.
                    </h2>
                    <p class="mt-2 text-slate-500">
                        Start free for 14 days. No credit card required.
                    </p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                        href={SIGNUP_URL}
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Start Free Trial
                    </a>
                    <a
                        href="/get-started/demo"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
