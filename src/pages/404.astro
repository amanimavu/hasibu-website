---
import BaseLayout from "../layouts/BaseLayout.astro";
import GridDecor from "../components/GridDecor.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout
    title="Page not found — Hasibu"
    description="The page you are looking for could not be found."
>
    <section
        class="relative flex min-h-[80vh] items-center justify-center overflow-clip bg-linear-to-b from-blue-50/60 via-white to-white px-6 py-24 landscape:min-h-screen"
    >
        <GridDecor />

        <div class="relative text-center">
            <!-- 4 [brand mark] 4 -->
            <div class="flex items-center justify-center gap-2 sm:gap-5">
                <span
                    class="text-[6.5rem] font-bold leading-none tracking-tight text-brand-dark sm:text-[10rem]"
                >
                    4
                </span>
                <svg
                    class="m-mark size-20 sm:size-36"
                    viewBox="0 0 256 256"
                    fill="none"
                    role="img"
                    aria-label="0"
                >
                    <path
                        class="m-glyph m-circle"
                        d="M64 117.333C93.4552 117.333 117.333 93.4552 117.333 64C117.333 34.5448 93.4552 10.6667 64 10.6667C34.5448 10.6667 10.6667 34.5448 10.6667 64C10.6667 93.4552 34.5448 117.333 64 117.333Z"
                        fill="#0066FF"
                    />
                    <path
                        class="m-glyph m-square"
                        d="M101.333 144H26.6667C20.7756 144 16 148.776 16 154.667V229.333C16 235.224 20.7756 240 26.6667 240H101.333C107.224 240 112 235.224 112 229.333V154.667C112 148.776 107.224 144 101.333 144Z"
                        fill="#0066FF"
                    />
                    <path
                        class="m-glyph m-tri"
                        d="M182.88 20.5867L137.707 96C136.775 97.6129 136.282 99.4416 136.277 101.304C136.272 103.167 136.755 104.998 137.677 106.616C138.599 108.234 139.929 109.583 141.534 110.527C143.14 111.472 144.964 111.98 146.827 112H237.173C239.036 111.98 240.86 111.472 242.465 110.527C244.071 109.583 245.401 108.234 246.323 106.616C247.245 104.998 247.728 103.167 247.723 101.304C247.717 99.4416 247.225 97.6129 246.293 96L201.12 20.5867C200.169 19.0192 198.83 17.7233 197.233 16.8239C195.635 15.9245 193.833 15.452 192 15.452C190.167 15.452 188.364 15.9245 186.767 16.8239C185.169 17.7233 183.831 19.0192 182.88 20.5867Z"
                        fill="#0066FF"
                    />
                    <g class="m-x">
                        <path
                            d="M240 144L144 240"
                            stroke="#CBD5E1"
                            stroke-width="16"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                        <path
                            d="M144 144L240 240"
                            stroke="#CBD5E1"
                            stroke-width="16"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </g>
                </svg>
                <span
                    class="text-[6.5rem] font-bold leading-none tracking-tight text-brand-dark sm:text-[10rem]"
                >
                    4
                </span>
            </div>

            <h1 class="mt-6 text-2xl font-bold text-brand-dark sm:text-3xl">
                Oops, page not found
            </h1>
            <p class="mx-auto mt-3 max-w-md text-slate-500">
                The page you are looking for moved, or never existed. Let us get
                you back on track.
            </p>

            <div
                class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
            >
                <a
                    href="/"
                    class="group inline-flex items-center justify-center gap-2 rounded-lg bg-brand px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90"
                >
                    <Icon
                        name="material-symbols:home-outline-rounded"
                        class="size-5"
                    />
                    Back home
                </a>
                <a
                    href="/product"
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 font-medium text-slate-700 transition hover:border-brand hover:text-brand"
                >
                    Explore the product
                    <Icon
                        name="material-symbols:arrow-forward-rounded"
                        class="size-5 transition-transform group-hover:translate-x-0.5"
                    />
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* Mark assembles once on view: circle, triangle, square, then the X draws
       in. Snappy pop with a little overshoot. (Same effect as the integrations
       hub.) */
    .m-glyph {
        transform-box: fill-box;
        transform-origin: center;
        opacity: 0;
        transform: scale(0.5);
    }
    .m-x path {
        stroke-dasharray: 136;
        stroke-dashoffset: 136;
    }
    .m-mark.in .m-circle {
        animation: g-pop 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    .m-mark.in .m-tri {
        animation: g-pop 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.16s forwards;
    }
    .m-mark.in .m-square {
        animation: g-pop 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.32s forwards;
    }
    .m-mark.in .m-x path {
        animation: x-draw 0.4s ease-out 0.5s forwards;
    }
    @keyframes g-pop {
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
    @keyframes x-draw {
        to {
            stroke-dashoffset: 0;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .m-glyph {
            opacity: 1;
            transform: none;
        }
        .m-x path {
            stroke-dashoffset: 0;
        }
        .m-mark.in .m-circle,
        .m-mark.in .m-tri,
        .m-mark.in .m-square,
        .m-mark.in .m-x path {
            animation: none;
        }
    }
</style>

<script>
    // Play the mark assembly whenever it scrolls into view; reset on leave so it
    // replays on re-entry.
    const marks = document.querySelectorAll<SVGElement>(".m-mark");
    for (const mark of marks) {
        const io = new IntersectionObserver(
            (entries) => {
                for (const e of entries) {
                    if (e.isIntersecting) {
                        mark.classList.remove("in");
                        void mark.getBoundingClientRect(); // reflow to restart
                        mark.classList.add("in");
                    } else {
                        mark.classList.remove("in");
                    }
                }
            },
            { threshold: 0.4 },
        );
        io.observe(mark);
    }
</script>
