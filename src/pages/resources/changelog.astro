---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import GridDecor from "../../components/GridDecor.astro";
import { releases, styleFor } from "../../data/changelog";
---

<BaseLayout
    title="Changelog — Hasibu"
    description="What is new in Hasibu: recent features and improvements across POS, inventory, payments, accounting and payroll."
>
    <!-- Header -->
    <section
        class="relative overflow-clip bg-linear-to-b from-blue-50/70 via-white to-white pt-28 pb-12 lg:pt-36 lg:pb-16"
    >
        <GridDecor />
        <div class="relative mx-auto max-w-3xl px-6 text-center">
            <span
                class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                Changelog
            </span>
            <h1
                class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-brand-dark sm:text-5xl"
            >
                What's <span class="text-brand">new.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg text-slate-500">
                Recent features and improvements across the platform.
            </p>
        </div>
    </section>

    <!-- Activity timeline -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-2xl px-6">
            <ol class="list-none">
                {
                    releases.map((r, i) => {
                        const s = styleFor(r.tag);
                        return (
                            <li class="flex gap-5 sm:gap-6">
                                {/* Rail: colour marker + connecting line */}
                                <div class="flex flex-col items-center">
                                    <span
                                        class={`mt-1.5 size-3.5 shrink-0 rounded-full ring-4 ring-white ${s.dot}`}
                                    />
                                    {i < releases.length - 1 && (
                                        <span class="mt-1 w-px grow bg-slate-200" />
                                    )}
                                </div>

                                {/* Entry */}
                                <div class="flex-1 pb-12">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                                        {r.date}
                                        <span class="mx-1.5 text-slate-300">
                                            /
                                        </span>
                                        <span class={s.accent}>{r.tag}</span>
                                    </p>
                                    <h2 class="mt-2 text-xl font-bold tracking-tight text-brand-dark sm:text-2xl">
                                        {r.title}
                                    </h2>
                                    <p class="mt-2 leading-relaxed text-slate-500">
                                        {r.summary}
                                    </p>
                                    <a
                                        href={`/resources/changelog/${r.slug}`}
                                        class={`group mt-3 inline-flex items-center gap-1 text-sm font-semibold ${s.accent}`}
                                    >
                                        Read more
                                        <Icon
                                            name="material-symbols:arrow-forward-rounded"
                                            class="size-4 transition-transform group-hover:translate-x-0.5"
                                        />
                                    </a>
                                </div>
                            </li>
                        );
                    })
                }
            </ol>
        </div>
    </section>
</BaseLayout>
