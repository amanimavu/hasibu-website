---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import GridDecor from "@components/GridDecor.astro";
import { loadPosts } from "@data/blog";

// Live posts from the Hasibu API when reachable, else the seed. Topics are
// grounded in real Hasibu capabilities so nothing here oversells.
const posts = await loadPosts();
---

<BaseLayout
    title="Blog — Hasibu"
    description="Product news, market insights and practical guides for running an African business on Hasibu."
>
    <!-- Header -->
    <section
        class="relative overflow-clip bg-linear-to-b from-blue-50/70 via-white to-white pt-28 pb-12 lg:pt-36 lg:pb-16"
    >
        <GridDecor />
        <div class="relative mx-auto max-w-3xl px-6 text-center">
            <span
                class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                Blog
            </span>
            <h1
                class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-brand-dark sm:text-5xl"
            >
                From the <span class="text-brand">Hasibu blog.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg text-slate-500">
                Product news, market insights and practical notes on running a
                business the way Africa actually trades.
            </p>
        </div>
    </section>

    <!-- Posts grid (grid style) -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="grid gap-px overflow-hidden rounded-2xl bg-slate-200 sm:grid-cols-2 lg:grid-cols-3"
            >
                {
                    posts.map((p) => (
                        <a
                            href={`/resources/blog/${p.slug}`}
                            class="group flex flex-col bg-white p-6 transition hover:bg-slate-50/70 lg:p-8"
                        >
                            <span class="text-xs font-semibold uppercase tracking-wide text-brand">
                                {p.category}
                            </span>
                            <h2 class="mt-3 text-lg font-semibold text-brand-dark">
                                {p.title}
                            </h2>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {p.excerpt}
                            </p>
                            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand">
                                Read more
                                <Icon
                                    name="material-symbols:arrow-forward-rounded"
                                    class="size-4 transition-transform group-hover:translate-x-0.5"
                                />
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>
