---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import GridDecor from "../../components/GridDecor.astro";

// Help Center categories. Grounded in the real modules; articles come later.
const categories = [
    {
        icon: "hugeicons:rocket-01",
        title: "Getting started",
        desc: "Set up your business, add your first location and invite your team.",
    },
    {
        icon: "hugeicons:shopping-cart-01",
        title: "Point of Sale",
        desc: "Run the till, open tabs and tables, and reprint receipts.",
    },
    {
        icon: "hugeicons:package",
        title: "Inventory & Stock",
        desc: "Stock counts, transfers, batches and expiry, and costing methods.",
    },
    {
        icon: "hugeicons:smart-phone-01",
        title: "Payments & M-Pesa",
        desc: "Connect M-Pesa, Airtel and MTN, and reconcile collections.",
    },
    {
        icon: "hugeicons:invoice-01",
        title: "Accounting & eTIMS",
        desc: "The general ledger, VAT, and KRA eTIMS fiscalization.",
    },
    {
        icon: "hugeicons:wallet-01",
        title: "Payroll",
        desc: "Salary runs, payslips, statutory deductions, advances and loans.",
    },
    {
        icon: "hugeicons:location-01",
        title: "Multi-location",
        desc: "Manage stock, prices and reports across every branch.",
    },
    {
        icon: "hugeicons:user-settings-01",
        title: "Account & billing",
        desc: "Your subscription, users, permissions and business settings.",
    },
];
---

<BaseLayout
    title="Help Center — Hasibu"
    description="Guides and answers for running your business on Hasibu: POS, inventory, payments, accounting, payroll and more."
>
    <!-- Header -->
    <section
        class="relative overflow-clip bg-linear-to-b from-blue-50/70 via-white to-white pt-28 pb-12 lg:pt-36 lg:pb-16"
    >
        <GridDecor />
        <div class="relative mx-auto max-w-3xl px-6 text-center">
            <span
                class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                Help Center
            </span>
            <h1
                class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-brand-dark sm:text-5xl"
            >
                How can we <span class="text-brand">help?</span>
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg text-slate-500">
                Browse by topic, or reach the team if you cannot find what you
                need.
            </p>
        </div>
    </section>

    <!-- Categories grid (grid style) -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="grid gap-px overflow-hidden rounded-2xl bg-slate-200 sm:grid-cols-2 lg:grid-cols-3"
            >
                {
                    categories.map((c) => (
                        <a
                            href="/company/contact"
                            class="group flex flex-col bg-white p-6 transition hover:bg-slate-50/70 lg:p-8"
                        >
                            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                                <Icon name={c.icon} class="size-6" />
                            </div>
                            <h2 class="mt-4 text-lg font-semibold text-brand-dark">
                                {c.title}
                            </h2>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {c.desc}
                            </p>
                        </a>
                    ))
                }
            </div>

            <div class="mt-10 text-center">
                <a
                    href="/company/contact"
                    class="group inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                >
                    Still stuck? Contact support
                    <Icon
                        name="material-symbols:arrow-forward-rounded"
                        class="size-4 transition-transform group-hover:translate-x-1.5"
                    />
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
