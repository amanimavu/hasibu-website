---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const methods = [
    {
        icon: "hugeicons:calendar-03",
        title: "Talk to sales",
        desc: "See Hasibu set up for your business.",
        cta: "Book a demo",
        href: "/get-started/demo",
    },
    {
        icon: "hugeicons:customer-support",
        title: "Get support",
        desc: "Already a customer? Find answers fast.",
        cta: "Help Center",
        href: "/resources/help",
    },
    {
        icon: "hugeicons:mail-01",
        title: "Email us",
        desc: "For anything else, drop us a line.",
        cta: "hello@hasibu.africa",
        href: "mailto:hello@hasibu.africa",
    },
];
---

<BaseLayout
    title="Contact — Hasibu"
    description="Get in touch with Hasibu. Talk to sales, book a demo, reach support, or send us a message."
>
    <!-- Hero -->
    <section
        class="bg-linear-to-b from-blue-50/70 via-white to-white pt-28 pb-12 lg:pt-36 lg:pb-16"
    >
        <div class="mx-auto max-w-3xl px-6 text-center">
            <span
                class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                Contact
            </span>
            <h1
                class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-brand-dark sm:text-5xl"
            >
                Let's talk.
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg text-slate-500">
                Whether you are sizing up Hasibu or already running on it, we are
                here to help.
            </p>
        </div>
    </section>

    <!-- Methods -->
    <section class="bg-white pb-16">
        <div class="mx-auto grid max-w-6xl gap-6 px-6 sm:grid-cols-3">
            {
                methods.map((m) => (
                    <a
                        href={m.href}
                        class="group flex flex-col rounded-2xl border border-slate-100 bg-white p-6 transition hover:border-blue-100 hover:shadow-lg hover:shadow-blue-500/5"
                    >
                        <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                            <Icon name={m.icon} class="size-6" />
                        </div>
                        <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                            {m.title}
                        </h3>
                        <p class="mt-2 text-sm leading-relaxed text-slate-500">
                            {m.desc}
                        </p>
                        <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand">
                            {m.cta}
                            <Icon
                                name="material-symbols:arrow-forward-rounded"
                                class="size-4 transition-transform group-hover:translate-x-0.5"
                            />
                        </span>
                    </a>
                ))
            }
        </div>
    </section>

    <!-- Form -->
    <section class="bg-white pb-20 lg:pb-28">
        <div class="mx-auto max-w-2xl px-6">
            <div class="rounded-2xl border border-slate-200 p-8 lg:p-10">
                <h2 class="text-2xl font-bold text-brand-dark">
                    Send us a message
                </h2>
                <p class="mt-2 text-sm text-slate-500">
                    Fill in the form and our team will get back to you.
                </p>

                <!-- TODO: wire `action` to a real endpoint (Directus form, Formspree, or your API). -->
                <form class="mt-8 space-y-5" action="#" method="post">
                    <div class="grid gap-5 sm:grid-cols-2">
                        <div>
                            <label
                                for="name"
                                class="block text-sm font-medium text-brand-dark"
                            >
                                Name
                            </label>
                            <input
                                id="name"
                                name="name"
                                type="text"
                                required
                                class="mt-2 w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/20"
                            />
                        </div>
                        <div>
                            <label
                                for="email"
                                class="block text-sm font-medium text-brand-dark"
                            >
                                Work email
                            </label>
                            <input
                                id="email"
                                name="email"
                                type="email"
                                required
                                class="mt-2 w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/20"
                            />
                        </div>
                    </div>
                    <div>
                        <label
                            for="company"
                            class="block text-sm font-medium text-brand-dark"
                        >
                            Business name
                        </label>
                        <input
                            id="company"
                            name="company"
                            type="text"
                            class="mt-2 w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/20"
                        />
                    </div>
                    <div>
                        <label
                            for="message"
                            class="block text-sm font-medium text-brand-dark"
                        >
                            How can we help?
                        </label>
                        <textarea
                            id="message"
                            name="message"
                            rows="4"
                            required
                            class="mt-2 w-full resize-y rounded-lg border border-slate-200 px-3 py-2.5 text-sm outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/20"
                        ></textarea>
                    </div>
                    <button
                        type="submit"
                        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                    >
                        Send message
                    </button>
                </form>
            </div>
        </div>
    </section>
</BaseLayout>
