---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GridDecor from "../../components/GridDecor.astro";
import { Icon } from "astro-icon/components";
import { CustomerSupportForm } from "@/components/react/CustomerSupportForm";

const methods = [
    {
        icon: "hugeicons:calendar-03",
        title: "Talk to sales",
        desc: "See Hasibu set up for your business.",
        cta: "Book a demo",
        href: "/get-started/demo",
    },
    {
        icon: "hugeicons:customer-support",
        title: "Get support",
        desc: "Already a customer? Find answers fast.",
        cta: "Help Center",
        href: "/resources/help",
    },
    {
        icon: "hugeicons:mail-01",
        title: "Email us",
        desc: "For anything else, drop us a line.",
        cta: "hello@hasibu.africa",
        href: "mailto:hello@hasibu.africa",
    },
];
---

<BaseLayout
    title="Contact — Hasibu"
    description="Get in touch with Hasibu. Talk to sales, book a demo, reach support, or send us a message."
>
    <!-- Hero -->
    <section
        class="relative overflow-clip bg-linear-to-b from-blue-50/70 via-white to-white pt-28 pb-12 lg:pt-36 lg:pb-16"
    >
        <GridDecor />
        <div class="relative mx-auto max-w-3xl px-6 text-center">
            <span
                class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                Contact
            </span>
            <h1
                class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-brand-dark sm:text-5xl"
            >
                Let's talk.
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg text-slate-500">
                Whether you are sizing up Hasibu or already running on it, we
                are here to help.
            </p>
        </div>
    </section>

    <!-- Methods -->
    <section class="bg-white pb-16">
        <div class="mx-auto max-w-6xl px-6">
            <div
                class="grid gap-px overflow-hidden rounded-2xl bg-slate-200 sm:grid-cols-3"
            >
                {
                    methods.map((m) => (
                        <a
                            href={m.href}
                            class="group flex flex-col bg-white p-6 transition hover:bg-slate-50/70 lg:p-8"
                        >
                            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-brand">
                                <Icon name={m.icon} class="size-6" />
                            </div>
                            <h3 class="mt-4 text-lg font-semibold text-brand-dark">
                                {m.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-500">
                                {m.desc}
                            </p>
                            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand">
                                {m.cta}
                                <Icon
                                    name="material-symbols:arrow-forward-rounded"
                                    class="size-4 transition-transform group-hover:translate-x-0.5"
                                />
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Form -->
    <section class="bg-slate-50 py-20 lg:py-28">
        <div class="mx-auto max-w-2xl px-6">
            <div
                class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200 lg:p-10"
            >
                <h2 class="text-2xl font-bold text-brand-dark">
                    Send us a message
                </h2>
                <p class="mt-2 text-sm text-slate-500">
                    Fill in the form and our team will get back to you.
                </p>

                <CustomerSupportForm client:visible />
            </div>
        </div>
    </section>
</BaseLayout>
