---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Chip {
    label: string;
    icon: string;
    color: string;
}

interface Props {
    badge: string;
    chips: Chip[];
    desktopImg: ImageMetadata;
    mobileImg: ImageMetadata;
    imgAlt: string;
    toolbarUrl: string;
    signupHref?: string;
}

const {
    badge,
    chips,
    desktopImg,
    mobileImg,
    imgAlt,
    toolbarUrl,
    signupHref = "https://app.hasibu.africa/signup",
} = Astro.props;

// Title + blurb come in via named slots so each page writes its own markup.
// Keep the accent word wrapped in <span class="text-brand"> for a consistent look.
---

<!-- Hero -->
<section
    class="relative overflow-clip bg-linear-60 from-[#F8FAFC] from-0% via-[#FFFFFF] via-50% to-[#EFF6FF]/40 to-100% pt-10 pb-20 lg:min-h-screen lg:pt-20 lg:pb-24"
>
    <div
        class="absolute aspect-square w-96 -right-20 -top-48 rounded-full bg-[#DBEAFE]/15 blur-xl"
    >
    </div>

    <!-- Copy -->
    <div class="relative z-10 ml-auto max-w-3xl px-6 p-15">
        <!-- Faded white panel behind the text (top/bottom/right dissolve) -->
        <div
            class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-r from-white from-0% to-transparent to-100% backdrop-blur-lg mask-(--hero-mask) mask-intersect [-webkit-mask-image:var(--hero-mask)] [-webkit-mask-composite:source-in]"
        >
        </div>

        <span
            class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
        >
            <span class="size-1.5 rounded-full bg-brand"></span>
            {badge}
        </span>

        <h1
            class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-brand-dark sm:text-5xl lg:text-6xl"
        >
            <slot name="title" />
        </h1>

        <p class="mt-6 max-w-xl text-lg text-slate-500">
            <slot name="blurb" />
        </p>

        <div class="mt-6 flex flex-wrap gap-2.5">
            {
                chips.map((c) => (
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600">
                        <Icon name={c.icon} class={`size-4 ${c.color}`} />
                        {c.label}
                    </span>
                ))
            }
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
                href={signupHref}
                class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90"
            >
                Start Free Trial
            </a>
            <!-- Dormant for now: will open a video modal (2 min product tour). -->
            <button
                type="button"
                data-tour-trigger
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 font-medium text-slate-700 transition hover:border-brand hover:text-brand"
            >
                <Icon
                    name="material-symbols:play-circle-outline"
                    class="size-5"
                />
                Watch 2 min tour
            </button>
        </div>
    </div>

    <!-- Real module screenshot: below the copy on mobile, offset on desktop -->
    <div
        class="relative z-9 mt-8 max-w-5xl px-6 lg:absolute lg:top-20 lg:mt-20"
    >
        <!-- Desktop: framed in a browser chrome -->
        <div
            class="hidden overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-2xl sm:block ml-10"
        >
            <div
                class="flex items-center gap-1.5 border-b border-slate-100 bg-white px-4 py-3"
            >
                <span class="size-3 rounded-full bg-red-400"></span>
                <span class="size-3 rounded-full bg-amber-400"></span>
                <span class="size-3 rounded-full bg-green-400"></span>
                <span class="ml-3 text-xs text-slate-400">{toolbarUrl}</span>
            </div>
            <Image
                src={desktopImg}
                alt={imgAlt}
                class="w-full"
                priority
                width={1280}
                densities={[1, 2]}
            />
        </div>

        <!-- Mobile -->
        <Image
            src={mobileImg}
            alt={imgAlt}
            class="mx-auto w-full max-w-75 rounded-2xl border border-slate-200 bg-slate-100 shadow-xl sm:hidden"
            priority
            width={400}
            densities={[1, 2]}
        />
    </div>
</section>
