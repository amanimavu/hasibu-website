---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { SIGNUP_URL } from "../lib/site";

interface Chip {
    label: string;
    icon: string;
    color: string;
}

interface Props {
    badge: string;
    chips: Chip[];
    // Framed-screenshot preset. For anything else (video, animation, diagram,
    // illustration) use the `graphic` slot instead.
    desktopImg?: ImageMetadata;
    mobileImg?: ImageMetadata;
    imgAlt: string;
    toolbarUrl: string;
    signupHref?: string;
}

const {
    badge,
    chips,
    desktopImg,
    mobileImg,
    imgAlt,
    toolbarUrl,
    signupHref = SIGNUP_URL,
} = Astro.props;

// Optional `graphic` named slot: custom right-side content (video, animation,
// diagram, illustration). Takes priority over the screenshot; rendered frameless.
const hasGraphic = Astro.slots.has("graphic");

// Title + blurb come in via named slots so each page writes its own markup.
// Keep the accent word wrapped in <span class="text-brand"> for a consistent look.
// Layout mirrors the landing Hero: copy + CTAs left, framed screenshot right.
---

<section
    class="relative overflow-clip bg-linear-60 from-[#F8FAFC] from-0% via-[#FFFFFF] via-50% to-[#EFF6FF]/40 to-100% lg:flex lg:min-h-screen lg:items-center"
>
    <div
        class="absolute aspect-square w-96 -right-24 -top-40 rounded-full bg-[#DBEAFE]/20 blur-2xl"
    >
    </div>
    <div
        class="absolute aspect-square w-72 -left-20 top-1/2 rounded-full bg-[#DBEAFE]/15 blur-2xl"
    >
    </div>

    <div
        class:list={[
            "relative mx-auto grid w-full max-w-7xl items-center gap-12 px-6 pt-28 pb-16 lg:py-24",
            hasGraphic ? "lg:grid-cols-[0.82fr_1.18fr] lg:gap-10" : "lg:grid-cols-2 lg:gap-12",
        ]}
    >
        <!-- Copy + CTAs (left) -->
        <div>
            <span
                class="inline-flex items-center gap-2 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                {badge}
            </span>

            <h1
                class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-brand-dark sm:text-5xl lg:text-6xl"
            >
                <slot name="title" />
            </h1>

            <p class="mt-6 max-w-lg text-lg text-slate-500">
                <slot name="blurb" />
            </p>

            <div class="mt-6 flex flex-wrap gap-2.5">
                {
                    chips.map((c) => (
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600">
                            <Icon name={c.icon} class={`size-4 ${c.color}`} />
                            {c.label}
                        </span>
                    ))
                }
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a
                    href={signupHref}
                    class="group inline-flex items-center justify-center gap-2 rounded-lg bg-brand px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90"
                >
                    Start Free Trial
                    <Icon
                        name="material-symbols:arrow-forward-rounded"
                        class="size-5 transition-transform group-hover:translate-x-0.5"
                    />
                </a>
                <!-- Dormant for now: will open a video modal (2 min product tour). -->
                <button
                    type="button"
                    data-tour-trigger
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 font-medium text-slate-700 transition hover:border-brand hover:text-brand"
                >
                    <Icon
                        name="material-symbols:play-circle-outline"
                        class="size-5"
                    />
                    Watch 2 min tour
                </button>
            </div>
        </div>

        <!-- Right: graphic slot (fills the column), else framed screenshot -->
        <div class:list={[hasGraphic ? "w-full" : "lg:justify-self-end"]}>
            {
                hasGraphic ? (
                    <div class="w-full">
                        <slot name="graphic" />
                    </div>
                ) : (
                    <Fragment>
                        <!-- Desktop: framed screenshot with a soft glow, a gentle
                             idle float, and an optional overlay slot for floating
                             callout cards. -->
                        <div class="relative hidden sm:block">
                            <div class="pointer-events-none absolute -inset-6 -z-10 rounded-[2.5rem] bg-brand/10 blur-3xl" />
                            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-2xl">
                                <div class="flex items-center gap-1.5 border-b border-slate-100 bg-white px-4 py-3">
                                    <span class="size-3 rounded-full bg-red-400" />
                                    <span class="size-3 rounded-full bg-amber-400" />
                                    <span class="size-3 rounded-full bg-green-400" />
                                    <span class="ml-3 truncate rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-400">
                                        {toolbarUrl}
                                    </span>
                                </div>
                                <Image
                                    src={desktopImg!}
                                    alt={imgAlt}
                                    class="w-full"
                                    priority
                                    width={1138}
                                    height={712}
                                    densities={[1, 2]}
                                    quality={95}
                                />
                            </div>
                            <div class="hero-overlay">
                                <slot name="overlay" />
                            </div>
                        </div>

                        <!-- Mobile -->
                        <Image
                            src={mobileImg!}
                            alt={imgAlt}
                            class="mx-auto w-full max-w-75 rounded-2xl border border-slate-200 bg-slate-100 shadow-xl sm:hidden"
                            priority
                            width={400}
                            densities={[1, 2]}
                        />
                    </Fragment>
                )
            }
        </div>
    </div>
</section>
