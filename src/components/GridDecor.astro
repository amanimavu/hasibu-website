---
import { Icon } from "astro-icon/components";

// Faint graph-paper grid with the Hasibu brand marks (x, circle, triangle,
// square) scattered randomly and sparsely across the cells, each tinted in
// Hasibu light or dark blue. Drop it as the first child of a `relative`
// section; it sits behind content and fades out downward.
interface Props {
    class?: string;
}
const { class: className = "" } = Astro.props;

// Seeded PRNG so the scatter is random-looking but stable across builds.
function mulberry32(seed: number) {
    return function () {
        seed |= 0;
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}

const rand = mulberry32(20260630);
const TYPES = ["x", "circle", "triangle", "square"] as const;
const TONES = ["light", "dark"] as const;
const CELL = 48;
const COLS = 30;
const ROWS = 19;
const MIN_DIST = 120; // no two marks closer than this
const SAME_DIST = 216; // no repeated shape / tone within this

type Mark = { cx: number; cy: number; type: string; tone: string };
const marks: Mark[] = [];
const near = (cx: number, cy: number, dist: number) =>
    marks.filter((m) => Math.hypot(m.cx - cx, m.cy - cy) < dist);

for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
        if (rand() >= 0.16) continue;
        const cx = c * CELL + CELL / 2;
        const cy = r * CELL + CELL / 2;
        if (near(cx, cy, MIN_DIST).length) continue; // too crowded

        const close = near(cx, cy, SAME_DIST);
        const usedTypes = new Set(close.map((m) => m.type));
        const usedTones = new Set(close.map((m) => m.tone));
        const typeChoices = TYPES.filter((t) => !usedTypes.has(t));
        if (!typeChoices.length) continue; // shape would repeat nearby
        const toneChoices = TONES.filter((t) => !usedTones.has(t));

        marks.push({
            cx,
            cy,
            type: typeChoices[Math.floor(rand() * typeChoices.length)],
            tone: (toneChoices.length ? toneChoices : TONES)[
                Math.floor(rand() * (toneChoices.length || TONES.length))
            ],
        });
    }
}

// Tone -> colour utility per glyph (literal classes so Tailwind keeps them).
const xColor = (t: string) => (t === "dark" ? "text-brand-dark" : "text-brand");
const fillColor = (t: string) => (t === "dark" ? "bg-brand-dark" : "bg-brand");
const triColor = (t: string) =>
    t === "dark" ? "border-b-brand-dark" : "border-b-brand";
---

<div
    aria-hidden="true"
    class={`pointer-events-none absolute inset-0 -z-10 overflow-hidden ${className}`}
>
    <!-- Grid lines -->
    <div
        class="absolute inset-0"
        style="background-image:linear-gradient(to right, rgb(148 163 184 / .35) 1px, transparent 1px),linear-gradient(to bottom, rgb(148 163 184 / .35) 1px, transparent 1px);background-size:48px 48px;"
    >
    </div>

    <!-- Scattered brand marks (centred in their cells) -->
    {
        marks.map((m) =>
            m.type === "x" ? (
                <Icon
                    name="material-symbols:close-rounded"
                    class={`absolute size-5 -translate-x-1/2 -translate-y-1/2 ${xColor(m.tone)}`}
                    style={`left:${m.cx}px;top:${m.cy}px;`}
                />
            ) : m.type === "circle" ? (
                <span
                    class={`absolute size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full ${fillColor(m.tone)}`}
                    style={`left:${m.cx}px;top:${m.cy}px;`}
                />
            ) : m.type === "triangle" ? (
                <span
                    class={`absolute h-0 w-0 -translate-x-1/2 -translate-y-1/2 border-x-[9px] border-b-15 border-x-transparent ${triColor(m.tone)}`}
                    style={`left:${m.cx}px;top:${m.cy}px;`}
                />
            ) : (
                <span
                    class={`absolute size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-[3px] ${fillColor(m.tone)}`}
                    style={`left:${m.cx}px;top:${m.cy}px;`}
                />
            ),
        )
    }

    <!-- Bottom fade: dissolves the grid + marks into the page. Inline so the
         height definitely applies (Tailwind h-1/x fractions are unreliable in
         v4). Change `height` below: SMALLER = grid reaches lower before fading;
         BIGGER = grid fades out higher up. -->
    <div
        style="position:absolute;left:0;right:0;bottom:0;height:10%;background-image:linear-gradient(to bottom, transparent 0%, white 100%);"
    >
    </div>
</div>
