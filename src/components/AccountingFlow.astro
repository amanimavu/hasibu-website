---
import { Icon } from "astro-icon/components";

// Accounting diagram: business events post themselves as balanced double-entry
// journals (with eTIMS fiscalization), into the General Ledger, out to financial
// statements. The journal card cycles through the entries. Grounded in the real
// module: double-entry GL, automatic COGS/VAT, eTIMS, P&L / Balance Sheet.

const events = [
    { icon: "material-symbols:shopping-cart-outline", label: "Sale" },
    { icon: "material-symbols:package-2-outline", label: "Purchase" },
    { icon: "material-symbols:payments-outline", label: "Expense" },
];

// Each cycles in the journal window (Dr / Cr, always balanced).
const entries = [
    { from: "Sale", dr: "Cash", drAmt: "84,200", cr: "Sales & VAT", crAmt: "84,200", etims: true },
    { from: "Purchase", dr: "Inventory", drAmt: "40,000", cr: "Accounts payable", crAmt: "40,000", etims: false },
    { from: "Expense", dr: "Rent", drAmt: "25,000", cr: "Cash", crAmt: "25,000", etims: false },
];

const statements = [
    { icon: "material-symbols:monitoring", label: "Profit & Loss", val: "Net +210k" },
    { icon: "material-symbols:balance", label: "Balance Sheet", val: "Assets = L + E" },
    { icon: "material-symbols:verified-user-outline", label: "VAT / eTIMS", val: "Filed" },
];
---

<div class="acc w-full">
    <div class="rounded-3xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
        <span
            class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-semibold text-brand-dark ring-1 ring-slate-200"
        >
            <Icon name="material-symbols:book-2-outline" class="size-3.5 text-brand" />
            Books that post themselves
        </span>

        <!-- Desktop pipeline: events -> journal -> statements -->
        <div class="mt-6 hidden grid-cols-[1fr_auto_1.5fr_auto_1.35fr] items-center gap-2.5 sm:grid">
            <!-- Events -->
            <div class="space-y-3">
                {
                    events.map((e) => (
                        <div class="flex items-center gap-3 rounded-xl bg-white p-3.5 shadow-sm ring-1 ring-slate-200">
                            <span class="flex size-10 items-center justify-center rounded-lg bg-blue-50 text-brand">
                                <Icon name={e.icon} class="size-5" />
                            </span>
                            <span class="whitespace-nowrap text-sm font-semibold text-brand-dark">
                                {e.label}
                            </span>
                        </div>
                    ))
                }
            </div>

            <Icon name="material-symbols:arrow-forward-rounded" class="size-5 shrink-0 text-slate-300" />

            <!-- Auto journal (carousel) -->
            <div class="rounded-2xl bg-white p-4 shadow-md ring-1 ring-slate-200">
                <div class="flex items-center justify-between">
                    <span class="whitespace-nowrap text-base font-bold text-brand-dark">Auto journal</span>
                    <span class="ml-2 whitespace-nowrap rounded bg-blue-50 px-2 py-0.5 text-[11px] font-semibold text-brand">double-entry</span>
                </div>
                <div class="j-window mt-3">
                    <div class="j-list">
                        {
                            [...entries, entries[0]].map((j) => (
                                <div class="j-entry">
                                    <div class="flex items-center justify-between text-sm">
                                        <span class="text-slate-400">Dr {j.dr}</span>
                                        <span class="font-semibold text-brand-dark">{j.drAmt}</span>
                                    </div>
                                    <div class="flex items-center justify-between text-sm">
                                        <span class="text-slate-400">Cr {j.cr}</span>
                                        <span class="font-semibold text-brand-dark">{j.crAmt}</span>
                                    </div>
                                    <div class="flex items-center gap-3 text-xs">
                                        <span class="inline-flex items-center gap-1 font-semibold text-green-600">
                                            <Icon name="material-symbols:check-circle" class="size-3.5" />
                                            Balanced
                                        </span>
                                        {j.etims && (
                                            <span class="inline-flex items-center gap-1 font-semibold text-teal-600">
                                                <Icon name="material-symbols:verified" class="size-3.5" />
                                                eTIMS
                                            </span>
                                        )}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
                <p class="mt-3 border-t border-slate-100 pt-3 text-xs text-slate-400">
                    Posted to the General Ledger
                </p>
            </div>

            <Icon name="material-symbols:arrow-forward-rounded" class="size-5 shrink-0 text-slate-300" />

            <!-- Statements -->
            <div class="space-y-3">
                {
                    statements.map((s) => (
                        <div class="rounded-xl bg-white p-3 shadow-sm ring-1 ring-slate-200">
                            <div class="flex items-center gap-1.5">
                                <Icon name={s.icon} class="size-5 shrink-0 text-brand" />
                                <span class="whitespace-nowrap text-sm font-semibold text-brand-dark">
                                    {s.label}
                                </span>
                            </div>
                            <p class="mt-1 whitespace-nowrap text-xs text-slate-400">{s.val}</p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Mobile: simple 3-step -->
        <div class="mt-4 flex flex-col gap-2 sm:hidden">
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <span class="flex size-9 items-center justify-center rounded-lg bg-blue-50 text-brand">
                    <Icon name="material-symbols:shopping-cart-outline" class="size-5" />
                </span>
                <div>
                    <p class="text-sm font-semibold text-brand-dark">Sale, purchase, expense</p>
                    <p class="text-xs text-slate-400">Every transaction you make</p>
                </div>
            </div>
            <Icon name="material-symbols:keyboard-arrow-down" class="mx-auto size-4 text-slate-300" />
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <span class="flex size-9 items-center justify-center rounded-lg bg-green-50 text-green-600">
                    <Icon name="material-symbols:check-circle" class="size-5" />
                </span>
                <div>
                    <p class="text-sm font-semibold text-brand-dark">Balanced journal, eTIMS</p>
                    <p class="text-xs text-slate-400">Double-entry, posted for you</p>
                </div>
            </div>
            <Icon name="material-symbols:keyboard-arrow-down" class="mx-auto size-4 text-slate-300" />
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <span class="flex size-9 items-center justify-center rounded-lg bg-blue-50 text-brand">
                    <Icon name="material-symbols:monitoring" class="size-5" />
                </span>
                <div>
                    <p class="text-sm font-semibold text-brand-dark">Statements, ready</p>
                    <p class="text-xs text-slate-400">P&L, balance sheet, VAT</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .j-window {
        height: 5rem;
        overflow: hidden;
    }
    .j-entry {
        height: 5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.3rem;
    }
    .j-list {
        animation: acc-roll 9s cubic-bezier(0.7, 0, 0.3, 1) infinite;
    }
    /* 3 entries + duplicated first = 4 slides; step -25% each. */
    @keyframes acc-roll {
        0%, 26% { transform: translateY(0); }
        33%, 59% { transform: translateY(-25%); }
        66%, 92% { transform: translateY(-50%); }
        100% { transform: translateY(-75%); }
    }
    @media (prefers-reduced-motion: reduce) {
        .j-list {
            animation: none;
        }
    }
</style>
