---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import digitax from "../../assets/images/partners/digitax-logo.png";
import network from "../../assets/images/partners/network.svg";

// Real partners. Add more files to src/assets/images/partners and list them here.
const partners = [
    {
        name: "Digitax",
        img: digitax,
        cls: "max-h-24",
        role: "Tax & compliance",
        desc: "KRA eTIMS fiscalization wired into Hasibu, so every sale and return is fiscalized automatically as you trade.",
    },
    {
        name: "Network",
        img: network,
        cls: "max-h-9",
        role: "Connectivity",
        desc: "Connecting Hasibu to the wider payments and business network across the markets we serve.",
    },
];
---

<section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-5xl px-6">
        <div class="mx-auto max-w-2xl text-center">
            <span
                class="inline-block rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-brand"
            >
                Partners
            </span>
            <h2
                class="mt-3 text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
            >
                The partners behind the platform.
            </h2>
            <p class="mt-4 text-slate-500">
                We work with the providers that keep African businesses
                compliant and connected, so the hard parts are handled for you.
            </p>
        </div>

        <!-- Partner cards (grid style) -->
        <div
            class="mt-12 grid gap-px overflow-hidden rounded-2xl bg-slate-200 sm:grid-cols-2"
        >
            {
                partners.map((p) => (
                    <div class="flex flex-col items-center bg-white p-10 text-center">
                        <div class="flex min-h-16 items-center">
                            <Image
                                src={p.img}
                                alt={p.name}
                                class={`w-auto object-contain ${p.cls}`}
                                loading="lazy"
                            />
                        </div>
                        <span class="mt-6 text-xs font-semibold uppercase tracking-wide text-brand">
                            {p.role}
                        </span>
                        <p class="mt-3 max-w-xs text-sm leading-relaxed text-slate-500">
                            {p.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
