---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import dashboardDesktop from "../../assets/images/desktop/screenshots/hasibu-dashboard.png";
import dashboardMobile from "../../assets/images/mobile/screenshots/hasibu-dashboard.png";
import brushStroke from "../../assets/images/brush_stroke.svg";
---

<section
    class="relative min-h-screen overflow-clip bg-linear-60 from-[#F8FAFC] from-0% via-[#FFFFFF] via-50% to-[#EFF6FF]/40 to-100%"
>
    <div
        class="absolute aspect-square w-96 -right-20 -top-48 rounded-full bg-[#DBEAFE]/10 blur-xl"
    >
    </div>
    <div
        class="absolute aspect-square w-48 -left-10 top-[85%] rounded-full bg-[#DBEAFE]/20 blur-xl"
    >
    </div>

    <div class="pt-20">
        <!-- Real dashboard screenshot: below the copy on mobile, offset left on desktop -->
        <div class="relative z-9 mt-8 max-w-5xl px-6 lg:absolute lg:top-30">
            <!-- Desktop: framed in a browser chrome -->
            <div
                class="mr-10 hidden overflow-hidden rounded-2xl border border-slate-200 shadow-2xl sm:block"
            >
                <div
                    class="flex items-center gap-1.5 border-b border-slate-100 bg-white px-4 py-3"
                >
                    <span class="size-3 rounded-full bg-red-400"></span>
                    <span class="size-3 rounded-full bg-amber-400"></span>
                    <span class="size-3 rounded-full bg-green-400"></span>
                    <span class="ml-3 text-xs text-slate-400">
                        business.hasibu.africa
                    </span>
                </div>
                <Image
                    src={dashboardDesktop}
                    alt="Hasibu dashboard showing revenue, orders, low stock alerts and recent mobile-money transactions"
                    class="w-full"
                    loading="eager"
                />
            </div>

            <!-- Mobile -->
            <Image
                src={dashboardMobile}
                alt="Hasibu dashboard on mobile"
                class="mx-auto w-full max-w-75 rounded-2xl border border-slate-200 shadow-xl sm:hidden"
                loading="eager"
            />
        </div>

        <!-- Copy (right, faded glass panel like the product heroes) -->
        <div class="relative z-10 ml-auto max-w-3xl px-6 p-15">
            <!-- Faded white panel behind the text (top/bottom/left dissolve) -->
            <div
                class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-r from-white from-0% to-transparent to-100% backdrop-blur-lg mask-(--hero-mask) mask-intersect [-webkit-mask-image:var(--hero-mask)] [-webkit-mask-composite:source-in]"
            >
            </div>

            <span
                class="inline-flex items-center gap-1.5 rounded-full bg-blue-100/70 px-3 py-1 text-xs font-semibold tracking-wide text-brand"
            >
                <Icon name="material-symbols:bolt" class="size-3.5" />
                PAN-AFRICAN ERP &amp; POS PLATFORM
            </span>

            <h1
                class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-brand-dark sm:text-5xl lg:text-6xl"
            >
                Built for the way<br />
                <span class="text-brand relative isolate inline-block"
                    >Africa actually<Image
                        src={brushStroke}
                        alt=""
                        aria-hidden="true"
                        class="pointer-events-none absolute -bottom-2 left-0 -z-10 w-full"
                        loading="eager"
                    />
                </span> runs.
            </h1>

            <p class="mt-6 max-w-lg text-lg text-slate-500">
                One platform for inventory, POS, accounting, HR, and sales —
                with local currencies, mobile money, and compliance built for
                Kenya, Rwanda and DR Congo.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a
                    href="https://app.hasibu.africa/signup"
                    class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90"
                >
                    Start Free Trial
                </a>
                <a
                    href="/get-started/demo"
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 font-medium text-slate-700 transition hover:border-brand hover:text-brand"
                >
                    <Icon
                        name="material-symbols:play-circle-outline"
                        class="size-5"
                    />
                    Book a Demo
                </a>
            </div>

            <!-- Social proof -->
            <div
                class="mt-6 pb-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500"
            >
                <span class="flex items-center gap-1.5">
                    <span class="flex text-amber-400">
                        <Icon name="material-symbols:star" class="size-4" />
                        <Icon name="material-symbols:star" class="size-4" />
                        <Icon name="material-symbols:star" class="size-4" />
                        <Icon name="material-symbols:star" class="size-4" />
                        <Icon name="material-symbols:star" class="size-4" />
                    </span>
                    100+ SMEs across Africa
                </span>
                <span class="flex items-center gap-1.5">
                    <Icon
                        name="material-symbols:check-circle"
                        class="size-4 text-slate-300"
                    />
                    No credit card required
                </span>
            </div>
        </div>
    </div>

