---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import dashboardDesktop from "@screenshots/desktop/dashboard-page.png";
import brushStroke from "../../assets/images/brush_stroke.svg";
import { SIGNUP_URL } from "../../lib/site";

// Social-proof logo strip. Representative SME names across the markets.
const clients = [
    { name: "Tujuane Mart", icon: "hugeicons:store-01" },
    { name: "Lagos Fresh Co.", icon: "hugeicons:shopping-basket-01" },
    { name: "Accra Distributors", icon: "hugeicons:warehouse" },
    { name: "Kigali Retail Hub", icon: "hugeicons:shopping-cart-01" },
    { name: "Nairobi Logistics", icon: "hugeicons:delivery-truck-01" },
];
---

<section
    class="relative overflow-clip bg-linear-60 from-[#F8FAFC] from-0% via-[#FFFFFF] via-50% to-[#EFF6FF]/40 to-100%"
>
    <div
        class="absolute aspect-square w-96 -right-24 -top-40 rounded-full bg-[#DBEAFE]/20 blur-2xl"
    >
    </div>
    <div
        class="absolute aspect-square w-72 -left-20 top-1/2 rounded-full bg-[#DBEAFE]/15 blur-2xl"
    >
    </div>

    <div
        class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 pt-28 pb-12 lg:grid-cols-2 lg:gap-12 lg:pt-32 lg:pb-16"
    >
        <!-- Copy + CTAs (left) -->
        <div>
            <span
                class="inline-flex items-center gap-1.5 rounded-full bg-blue-100/70 px-3 py-1.5 text-xs font-semibold tracking-wide text-brand"
            >
                <span class="size-1.5 rounded-full bg-brand"></span>
                PAN-AFRICAN ERP &amp; POS PLATFORM
            </span>

            <h1
                class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-brand-dark sm:text-5xl lg:text-6xl"
            >
                Built for the way<br />
                <span class="text-brand relative isolate inline-block"
                    >Africa actually<Image
                        src={brushStroke}
                        alt=""
                        aria-hidden="true"
                        class="pointer-events-none absolute -bottom-2 left-0 -z-10 w-full"
                    />
                </span> runs.
            </h1>

            <p class="mt-6 max-w-lg text-lg text-slate-500">
                One platform for inventory, POS, accounting, HR and sales, with
                local currencies, mobile money and compliance built for Kenya,
                Rwanda and DR Congo.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a
                    href={SIGNUP_URL}
                    class="group inline-flex items-center justify-center gap-2 rounded-lg bg-brand px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90"
                >
                    Start Free Trial
                    <Icon
                        name="material-symbols:arrow-forward-rounded"
                        class="size-5 transition-transform group-hover:translate-x-0.5"
                    />
                </a>
                <a
                    href="/get-started/demo"
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 font-medium text-slate-700 transition hover:border-brand hover:text-brand"
                >
                    <Icon
                        name="material-symbols:play-circle-outline"
                        class="size-5"
                    />
                    Book a Demo
                </a>
            </div>

            <!-- Social proof -->
            <div
                class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-500"
            >
                <span class="flex items-center gap-2">
                    <span class="flex text-amber-400">
                        <Icon name="material-symbols:star" class="size-4" />
                        <Icon name="material-symbols:star" class="size-4" />
                        <Icon name="material-symbols:star" class="size-4" />
                        <Icon name="material-symbols:star" class="size-4" />
                        <Icon name="material-symbols:star" class="size-4" />
                    </span>
                    <span><strong class="text-brand-dark">100+</strong> SMEs across Africa</span>
                </span>
                <span class="flex items-center gap-1.5">
                    <Icon
                        name="material-symbols:check-circle"
                        class="size-4 text-green-500"
                    />
                    No credit card required
                </span>
            </div>
        </div>

        <!-- Dashboard screenshot in browser chrome, with floating accent cards (right) -->
        <div class="relative lg:justify-self-end">
            <div
                class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-2xl"
            >
                <div
                    class="flex items-center gap-1.5 border-b border-slate-100 bg-white px-4 py-3"
                >
                    <span class="size-3 rounded-full bg-red-400"></span>
                    <span class="size-3 rounded-full bg-amber-400"></span>
                    <span class="size-3 rounded-full bg-green-400"></span>
                    <span
                        class="ml-3 truncate rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-400"
                    >
                        business.hasibu.africa/dashboard
                    </span>
                </div>
                <Image
                    src={dashboardDesktop}
                    alt="Hasibu dashboard showing revenue, orders, low stock alerts and recent mobile-money transactions"
                    class="w-full"
                    priority
                    width={1280}
                    densities={[1, 2]}
                />
            </div>

            <!-- Floating: live sync pill (top-right) -->
            <div
                class="absolute -top-4 right-6 hidden items-center gap-1.5 rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-white shadow-lg sm:flex"
            >
                <Icon name="material-symbols:bolt" class="size-3.5" />
                Live sync
            </div>

            <!-- Floating: mobile-money card (bottom-left) -->
            <div
                class="absolute -bottom-5 -left-4 hidden items-center gap-3 rounded-xl border border-slate-100 bg-white px-4 py-3 shadow-xl sm:flex"
            >
                <span
                    class="flex size-8 items-center justify-center rounded-full bg-green-50 text-green-600"
                >
                    <Icon name="material-symbols:check-rounded" class="size-5" />
                </span>
                <div class="leading-tight">
                    <p class="text-sm font-semibold text-brand-dark">
                        Mobile money
                    </p>
                    <p class="text-xs text-slate-400">M-Pesa, Airtel, MTN</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Trusted by -->
    <div class="mx-auto max-w-7xl px-6 pb-16">
        <div class="border-t border-slate-100 pt-10">
            <p
                class="text-center text-xs font-semibold uppercase tracking-wider text-slate-400"
            >
                Trusted by SMEs across Africa
            </p>
            <div
                class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 lg:gap-x-14"
            >
                {
                    clients.map((c) => (
                        <div class="flex items-center gap-2 text-slate-300 transition hover:text-slate-400">
                            <Icon name={c.icon} class="size-6" />
                            <span class="text-base font-medium">{c.name}</span>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
