---
import { Icon } from "astro-icon/components";
import { directus, readItems, readSingleton } from "../../lib/directus";
import type { PricingTier } from "../../lib/directus";
import { SIGNUP_URL } from "../../lib/site";

interface Props {
    // Pages with their own decorated header (e.g. /pricing) hide this.
    showHeader?: boolean;
}
const { showHeader = true } = Astro.props;

interface Feature {
    label: string;
    included: boolean;
}
interface Row {
    name: string;
    blurb: string;
    monthly: { price: string; billed: string };
    quarterly: { price: string; billed: string };
    annual: { price: string; billed: string };
    limits: string;
    popular: boolean;
    cta: { label: string; href: string; style: "outline" | "solid" | "dark" };
    features: Feature[];
}

// Fallback seed (real Kenya plans, ex-VAT). Live plans come from Directus
// `pricing_tiers`; there may be up to 5.
const seed: Row[] = [
    {
        name: "Starter",
        blurb: "Get selling, stay compliant. For a single shop getting started.",
        monthly: { price: "KES 2,000", billed: "Billed monthly, excl. VAT" },
        quarterly: { price: "KES 1,800", billed: "Billed quarterly (KES 5,400/qtr), excl. VAT" },
        annual: { price: "KES 1,700", billed: "Billed annually (KES 20,400/yr), excl. VAT" },
        limits: "3 users · 1 shop",
        popular: false,
        cta: { label: "Start Free Trial", href: SIGNUP_URL, style: "outline" },
        features: [
            "POS, products & inventory",
            "eTIMS + M-Pesa payments",
            "Suppliers, customers, SMS & email",
        ].map((label) => ({ label, included: true })),
    },
    {
        name: "Growth",
        blurb: "Run the whole operation. For a growing business with stock & staff.",
        monthly: { price: "KES 4,500", billed: "Billed monthly, excl. VAT" },
        quarterly: { price: "KES 4,050", billed: "Billed quarterly (KES 12,150/qtr), excl. VAT" },
        annual: { price: "KES 3,825", billed: "Billed annually (KES 45,900/yr), excl. VAT" },
        limits: "8 users · 1 shop · unlimited stores",
        popular: true,
        cta: { label: "Start Free Trial", href: SIGNUP_URL, style: "solid" },
        features: [
            "Everything in Starter",
            "Purchases, production, variants",
            "Expenses, AR/AP, petty cash",
            "Quotes, orders, commissions",
        ].map((label) => ({ label, included: true })),
    },
    {
        name: "Enterprise",
        blurb: "Scale on your terms. For multi-branch & advanced needs.",
        monthly: { price: "Let's talk", billed: "Custom quote" },
        quarterly: { price: "Let's talk", billed: "Custom quote" },
        annual: { price: "Let's talk", billed: "Custom quote" },
        limits: "Custom users, shops & limits",
        popular: false,
        cta: { label: "Contact Sales", href: "/get-started/contact-sales", style: "dark" },
        features: [
            "Everything in Growth",
            "Advanced finance (assets, JVs)",
            "API & custom integrations",
            "Dedicated onboarding & SLA",
        ].map((label) => ({ label, included: true })),
    },
];

// Footnote as discrete, scannable facts (rendered dot-separated). In the CMS,
// `pricing_settings.note` holds them one per line (or pipe-separated).
const seedNoteItems = [
    "30-day free trial",
    "10% off quarterly",
    "15% off annual",
    "Add a shop: KES 4,500/mo",
    "Add a user: KES 500/mo",
    "Prices exclude VAT (16% at billing)",
];

// Build-time fetch from Directus, falling back to the seed.
let rows: Row[] = seed;
let noteItems = seedNoteItems;
let usingSeed = true;
try {
    const data = (await directus.request(
        readItems("pricing_tiers", {
            filter: { status: { _eq: "published" } },
            sort: ["sort"],
        }),
    )) as PricingTier[];
    if (data.length) {
        rows = data.map((t) => ({
            name: t.name,
            blurb: t.blurb ?? "",
            monthly: { price: t.price_monthly, billed: t.billed_monthly },
            quarterly: { price: t.price_quarterly, billed: t.billed_quarterly },
            annual: { price: t.price_annual, billed: t.billed_annual },
            limits: t.limits ?? "",
            popular: t.popular,
            cta: { label: t.cta_label, href: t.cta_href, style: t.cta_style },
            features: t.features ?? [],
        }));
        usingSeed = false;
    }
} catch {
    console.warn("[Pricing] Directus unavailable, using seed pricing.");
}

try {
    const settings = await directus.request(readSingleton("pricing_settings"));
    if (settings?.notes?.length) noteItems = settings.notes;
} catch {
    // keep seed note items
}

// Up to 5 plans: show 3 by default, reveal the rest. The window is centered on the
// popular plan when there is one, otherwise on the median, so popular is never hidden.
const n = rows.length;
const popularIdx = rows.findIndex((r) => r.popular);
let start = 0;
if (n > 3) {
    start =
        popularIdx >= 0
            ? Math.min(Math.max(popularIdx - 1, 0), n - 3)
            : Math.floor((n - 3) / 2);
}
const view = rows.map((r, i) => ({ ...r, primary: i >= start && i < start + 3 }));
const hasExtra = n > 3;

const ctaClass: Record<string, string> = {
    outline: "border border-brand text-brand hover:bg-brand hover:text-white",
    solid: "bg-brand text-white shadow-sm hover:opacity-90",
    dark: "border border-slate-300 text-brand-dark hover:border-brand hover:text-brand",
};
---

<section class="bg-slate-50 py-20 lg:py-28">
    <div class="mx-auto max-w-6xl px-6">
        {showHeader && (
            <div class="mx-auto max-w-2xl text-center">
                <span class="inline-block rounded-full bg-blue-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-brand">
                    Pricing
                </span>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl">
                    Simple, transparent pricing<br class="hidden sm:block" /> for
                    every stage.
                </h2>
                <p class="mt-4 text-slate-500">
                    No hidden fees. Pay in your local currency. Cancel anytime.
                </p>
            </div>
        )}

        <!-- Billing segmented control -->
        <div class="mt-8 flex justify-center">
            <div
                id="billing-seg"
                role="tablist"
                aria-label="Billing cadence"
                class="relative inline-flex rounded-full bg-slate-100 p-1 text-sm font-medium"
            >
                <span
                    id="seg-thumb"
                    class="pointer-events-none absolute bottom-1 left-1 top-1 rounded-full bg-white shadow-sm transition-all duration-300 ease-out"
                    style="width:0"
                ></span>
                <!-- Floats up + fades when a discounted cadence is picked. -->
                <span
                    id="seg-float"
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 z-20 whitespace-nowrap rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-semibold text-green-700 opacity-0"
                ></span>
                <button
                    type="button"
                    role="tab"
                    data-mode="monthly"
                    aria-selected="true"
                    class="seg-btn relative z-10 cursor-pointer rounded-full px-4 py-1.5 text-brand-dark transition-colors"
                >
                    Monthly
                </button>
                <button
                    type="button"
                    role="tab"
                    data-mode="quarterly"
                    data-save="Save 10%"
                    aria-selected="false"
                    class="seg-btn relative z-10 cursor-pointer rounded-full px-4 py-1.5 text-slate-500 transition-colors"
                >
                    Quarterly
                </button>
                <button
                    type="button"
                    role="tab"
                    data-mode="annual"
                    data-save="Save 15%"
                    aria-selected="false"
                    class="seg-btn relative z-10 cursor-pointer rounded-full px-4 py-1.5 text-slate-500 transition-colors"
                >
                    Annual
                </button>
            </div>
        </div>

        <!-- Cards: flex-wrap centers any count from 1 to 5 -->
        <div
            id="pricing-cards"
            class="mt-12 flex flex-wrap items-start justify-center gap-6"
        >
            {
                view.map((t) => (
                    <article
                        data-extra={t.primary ? undefined : "true"}
                        class:list={[
                            "relative flex w-full flex-col rounded-2xl bg-white p-8 sm:w-80",
                            t.popular
                                ? "border-2 border-brand shadow-xl shadow-blue-500/10 lg:-my-4 lg:py-12"
                                : "border border-slate-200",
                            !t.primary && "hidden",
                        ]}
                    >
                        {t.popular && (
                            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand px-3 py-1 text-xs font-medium text-white">
                                Most Popular
                            </span>
                        )}

                        <h3 class="text-lg font-semibold text-brand-dark">
                            {t.name}
                        </h3>
                        <p class="mt-2 text-sm text-slate-500">{t.blurb}</p>

                        <p class="mt-6">
                            <span
                                class="text-4xl font-bold text-brand-dark"
                                data-price
                                data-monthly={t.monthly.price}
                                data-quarterly={t.quarterly.price}
                                data-annual={t.annual.price}
                            >
                                {t.monthly.price}
                            </span>
                            <span class="text-sm font-normal text-slate-400">
                                {" "}
                                /month
                            </span>
                        </p>
                        <p
                            class="mt-1 text-xs text-slate-400"
                            data-billed
                            data-monthly={t.monthly.billed}
                            data-quarterly={t.quarterly.billed}
                            data-annual={t.annual.billed}
                        >
                            {t.monthly.billed}
                        </p>

                        {t.limits && (
                            <p class="mt-3 text-xs font-medium text-slate-500">
                                {t.limits}
                            </p>
                        )}

                        <a
                            href={t.cta.href}
                            class={`mt-6 inline-flex items-center justify-center gap-1.5 rounded-lg px-4 py-2.5 text-sm font-medium transition ${ctaClass[t.cta.style]}`}
                        >
                            {t.cta.label}
                            {t.cta.style === "solid" && (
                                <Icon
                                    name="material-symbols:arrow-forward-rounded"
                                    class="size-4"
                                />
                            )}
                        </a>

                        <ul class="mt-8 space-y-3 border-t border-slate-100 pt-6">
                            {t.features.map((f) => (
                                <li class="flex items-center gap-2 text-sm">
                                    <Icon
                                        name="material-symbols:check-rounded"
                                        class={`size-4 shrink-0 ${f.included ? "text-brand" : "text-slate-300"}`}
                                    />
                                    <span class={f.included ? "text-slate-600" : "text-slate-300"}>
                                        {f.label}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    </article>
                ))
            }
        </div>

        {
            hasExtra && (
                <div class="mt-10 text-center">
                    <button
                        id="see-all-plans"
                        type="button"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                        data-expanded="false"
                        data-count={n}
                    >
                        <span data-label>See all {n} plans</span>
                        <Icon
                            name="material-symbols:keyboard-arrow-down"
                            class="size-4"
                        />
                    </button>
                </div>
            )
        }

        {noteItems.length > 0 && (
            <ul class="mx-auto mt-10 flex max-w-3xl flex-wrap items-center justify-center gap-x-2.5 gap-y-1.5 text-xs text-slate-500">
                {noteItems.map((it, i) => (
                    <li class="flex items-center gap-2.5">
                        {i > 0 && (
                            <span
                                aria-hidden="true"
                                class="size-1 shrink-0 rounded-full bg-slate-400"
                            />
                        )}
                        <span>{it}</span>
                    </li>
                ))}
            </ul>
        )}

        {
            usingSeed && (
                <p class="mt-3 text-center text-xs text-slate-400">
                    Sample pricing. Final plans are managed in the CMS.
                </p>
            )
        }
    </div>
</section>

<script>
    // Billing segmented control: monthly / quarterly / annual with a sliding thumb
    const seg = document.getElementById("billing-seg");
    const thumb = document.getElementById("seg-thumb");
    const segBtns = seg
        ? [...seg.querySelectorAll<HTMLButtonElement>(".seg-btn")]
        : [];

    const moveThumb = (btn: HTMLButtonElement) => {
        if (!thumb) return;
        thumb.style.left = `${btn.offsetLeft}px`;
        thumb.style.width = `${btn.offsetWidth}px`;
    };

    const float = document.getElementById("seg-float");
    const popFloat = (btn: HTMLButtonElement) => {
        if (!float) return;
        const save = btn.dataset.save;
        if (!save) return; // monthly has no discount
        float.textContent = save;
        // Center over the active button (measured after it may have moved).
        float.style.left = `${btn.offsetLeft + btn.offsetWidth / 2}px`;
        float.classList.remove("pop");
        void float.offsetWidth; // reflow to restart the animation
        float.classList.add("pop");
    };

    const setMode = (mode: string) => {
        let active = segBtns[0];
        segBtns.forEach((b) => {
            const on = b.dataset.mode === mode;
            if (on) active = b;
            b.setAttribute("aria-selected", String(on));
            b.classList.toggle("text-brand-dark", on);
            b.classList.toggle("text-slate-500", !on);
        });
        if (active) {
            moveThumb(active);
            popFloat(active);
        }
        document
            .querySelectorAll<HTMLElement>("[data-price], [data-billed]")
            .forEach((el) => {
                const val = el.dataset[mode];
                if (val) el.textContent = val;
            });
    };
    segBtns.forEach((b) =>
        b.addEventListener("click", () => setMode(b.dataset.mode ?? "monthly")),
    );

    // Place the thumb under the initial selection without animating the first paint.
    const initThumb = () => {
        const active =
            segBtns.find((b) => b.getAttribute("aria-selected") === "true") ??
            segBtns[0];
        if (!thumb || !active) return;
        thumb.style.transition = "none";
        moveThumb(active);
        void thumb.offsetWidth; // reflow
        thumb.style.transition = "";
    };
    initThumb();
    window.addEventListener("resize", () => {
        const active =
            segBtns.find((b) => b.getAttribute("aria-selected") === "true") ??
            segBtns[0];
        if (active) moveThumb(active);
    });

    // See all plans
    const seeAll = document.getElementById("see-all-plans");
    seeAll?.addEventListener("click", () => {
        const expanded = seeAll.getAttribute("data-expanded") === "true";
        const next = !expanded;
        seeAll.setAttribute("data-expanded", String(next));
        document
            .querySelectorAll<HTMLElement>("#pricing-cards [data-extra]")
            .forEach((el) => el.classList.toggle("hidden", !next));
        const label = seeAll.querySelector("[data-label]");
        const count = seeAll.getAttribute("data-count");
        if (label) label.textContent = next ? "Show fewer" : `See all ${count} plans`;
        seeAll.querySelector("svg")?.classList.toggle("rotate-180", next);
    });
</script>

<style>
    /* Discount pill rises above the active segment and fades out. Base transform
       keeps it centered (X) while the animation drives the Y rise. */
    #seg-float {
        transform: translate(-50%, -60%);
    }
    #seg-float.pop {
        animation: seg-float 2.2s ease-out forwards;
    }
    @keyframes seg-float {
        0% {
            opacity: 0;
            transform: translate(-50%, -30%) scale(0.85);
        }
        14% {
            opacity: 1;
            transform: translate(-50%, -95%) scale(1);
        }
        70% {
            opacity: 1;
            transform: translate(-50%, -110%) scale(1);
        }
        100% {
            opacity: 0;
            transform: translate(-50%, -175%) scale(1);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        #seg-float.pop {
            animation: none;
            opacity: 0;
        }
    }
</style>
