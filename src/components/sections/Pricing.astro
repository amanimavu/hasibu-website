---
import { Icon } from "astro-icon/components";
import { directus, readItems } from "../../lib/directus";
import type { PricingTier } from "../../lib/directus";

interface Feature {
    label: string;
    included: boolean;
}
interface Row {
    name: string;
    blurb: string;
    monthly: { price: string; billed: string };
    annual: { price: string; billed: string };
    popular: boolean;
    cta: { label: string; href: string; style: "outline" | "solid" | "dark" };
    features: Feature[];
}

// Fallback seed (sample numbers). Real plans come from Directus `pricing_tiers`.
// Owners haven't finalized plans yet and there may be up to 5.
const seed: Row[] = [
    {
        name: "Starter",
        blurb: "For micro and solo-run businesses just getting started.",
        monthly: { price: "$19", billed: "Billed monthly" },
        annual: { price: "$15", billed: "Billed annually" },
        popular: false,
        cta: { label: "Start Free Trial", href: "/get-started/signup", style: "outline" },
        features: [
            { label: "1 location", included: true },
            { label: "POS & Inventory (basic)", included: true },
            { label: "Up to 3 users", included: true },
            { label: "Mobile money integrations", included: true },
            { label: "Accounting module", included: false },
            { label: "Multi-currency", included: false },
            { label: "HR & Payroll", included: false },
        ],
    },
    {
        name: "Growth",
        blurb: "For growing SMEs with multiple staff and locations.",
        monthly: { price: "$49", billed: "Billed monthly" },
        annual: { price: "$39", billed: "Billed annually" },
        popular: true,
        cta: { label: "Start Free Trial", href: "/get-started/signup", style: "solid" },
        features: [
            "Up to 5 locations",
            "Full POS & Inventory",
            "Up to 20 users",
            "Accounting & invoicing",
            "Multi-currency support",
            "Sales CRM",
            "HR & Payroll",
        ].map((label) => ({ label, included: true })),
    },
    {
        name: "Enterprise",
        blurb: "For distributors, chains, and enterprise SMEs.",
        monthly: { price: "$129", billed: "Billed monthly" },
        annual: { price: "$103", billed: "Billed annually" },
        popular: false,
        cta: { label: "Contact Sales", href: "/get-started/contact-sales", style: "dark" },
        features: [
            "Unlimited locations",
            "All modules included",
            "Unlimited users",
            "HR, Payroll & compliance",
            "Custom API integrations",
            "Dedicated account manager",
            "SLA & priority support",
        ].map((label) => ({ label, included: true })),
    },
];

// Build-time fetch from Directus, falling back to the seed.
let rows: Row[] = seed;
let usingSeed = true;
try {
    const data = (await directus.request(
        readItems("pricing_tiers", {
            filter: { status: { _eq: "published" } },
            sort: ["sort"],
        }),
    )) as PricingTier[];
    if (data.length) {
        rows = data.map((t) => ({
            name: t.name,
            blurb: t.blurb ?? "",
            monthly: { price: t.price_monthly, billed: t.billed_monthly },
            annual: { price: t.price_annual, billed: t.billed_annual },
            popular: t.popular,
            cta: { label: t.cta_label, href: t.cta_href, style: t.cta_style },
            features: t.features ?? [],
        }));
        usingSeed = false;
    }
} catch {
    console.warn("[Pricing] Directus unavailable, using seed pricing.");
}

// Up to 5 plans: show 3 by default, reveal the rest. The window is centered on the
// popular plan when there is one, otherwise on the median, so popular is never hidden.
const n = rows.length;
const popularIdx = rows.findIndex((r) => r.popular);
let start = 0;
if (n > 3) {
    start =
        popularIdx >= 0
            ? Math.min(Math.max(popularIdx - 1, 0), n - 3)
            : Math.floor((n - 3) / 2);
}
const view = rows.map((r, i) => ({ ...r, primary: i >= start && i < start + 3 }));
const hasExtra = n > 3;

const ctaClass: Record<string, string> = {
    outline: "border border-brand text-brand hover:bg-brand hover:text-white",
    solid: "bg-brand text-white shadow-sm hover:opacity-90",
    dark: "border border-slate-300 text-brand-dark hover:border-brand hover:text-brand",
};
---

<section class="bg-slate-50 py-20 lg:py-28">
    <div class="mx-auto max-w-6xl px-6">
        <!-- Heading -->
        <div class="mx-auto max-w-2xl text-center">
            <span
                class="inline-block rounded-full bg-blue-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-brand"
            >
                Pricing
            </span>
            <h2
                class="mt-3 text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl"
            >
                Simple, transparent pricing<br class="hidden sm:block" /> for every
                stage.
            </h2>
            <p class="mt-4 text-slate-500">
                No hidden fees. Pay in your local currency. Cancel anytime.
            </p>
        </div>

        <!-- Billing toggle -->
        <div class="mt-8 flex items-center justify-center gap-3">
            <span
                id="lbl-monthly"
                class="text-sm font-medium text-brand-dark transition-colors"
            >
                Monthly
            </span>
            <button
                id="billing-toggle"
                type="button"
                role="switch"
                aria-checked="false"
                aria-label="Toggle annual billing"
                class="relative h-6 w-11 rounded-full bg-brand transition-colors"
            >
                <span
                    id="billing-knob"
                    class="absolute left-0.5 top-0.5 size-5 rounded-full bg-white shadow transition-transform"
                ></span>
            </button>
            <span
                id="lbl-annual"
                class="text-sm font-medium text-slate-400 transition-colors"
            >
                Annual
            </span>
            <span
                class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700"
            >
                Save 20%
            </span>
        </div>

        <!-- Cards: flex-wrap centers any count from 1 to 5 -->
        <div
            id="pricing-cards"
            class="mt-12 flex flex-wrap items-start justify-center gap-6"
        >
            {
                view.map((t) => (
                    <article
                        data-extra={t.primary ? undefined : "true"}
                        class:list={[
                            "relative flex w-full flex-col rounded-2xl bg-white p-8 sm:w-80",
                            t.popular
                                ? "border-2 border-brand shadow-xl shadow-blue-500/10 lg:-my-4 lg:py-12"
                                : "border border-slate-200",
                            !t.primary && "hidden",
                        ]}
                    >
                        {t.popular && (
                            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand px-3 py-1 text-xs font-medium text-white">
                                Most Popular
                            </span>
                        )}

                        <h3 class="text-lg font-semibold text-brand-dark">
                            {t.name}
                        </h3>
                        <p class="mt-2 text-sm text-slate-500">{t.blurb}</p>

                        <p class="mt-6">
                            <span
                                class="text-4xl font-bold text-brand-dark"
                                data-price
                                data-monthly={t.monthly.price}
                                data-annual={t.annual.price}
                            >
                                {t.monthly.price}
                            </span>
                            <span class="text-sm font-normal text-slate-400">
                                {" "}
                                /month
                            </span>
                        </p>
                        <p
                            class="mt-1 text-xs text-slate-400"
                            data-billed
                            data-monthly={t.monthly.billed}
                            data-annual={t.annual.billed}
                        >
                            {t.monthly.billed}
                        </p>

                        <a
                            href={t.cta.href}
                            class={`mt-6 inline-flex items-center justify-center gap-1.5 rounded-lg px-4 py-2.5 text-sm font-medium transition ${ctaClass[t.cta.style]}`}
                        >
                            {t.cta.label}
                            {t.cta.style === "solid" && (
                                <Icon
                                    name="material-symbols:arrow-forward-rounded"
                                    class="size-4"
                                />
                            )}
                        </a>

                        <ul class="mt-8 space-y-3 border-t border-slate-100 pt-6">
                            {t.features.map((f) => (
                                <li class="flex items-center gap-2 text-sm">
                                    <Icon
                                        name="material-symbols:check-rounded"
                                        class={`size-4 shrink-0 ${f.included ? "text-brand" : "text-slate-300"}`}
                                    />
                                    <span class={f.included ? "text-slate-600" : "text-slate-300"}>
                                        {f.label}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    </article>
                ))
            }
        </div>

        {
            hasExtra && (
                <div class="mt-10 text-center">
                    <button
                        id="see-all-plans"
                        type="button"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                        data-expanded="false"
                        data-count={n}
                    >
                        <span data-label>See all {n} plans</span>
                        <Icon
                            name="material-symbols:keyboard-arrow-down"
                            class="size-4"
                        />
                    </button>
                </div>
            )
        }

        {
            usingSeed && (
                <p class="mt-8 text-center text-xs text-slate-400">
                    Sample pricing. Final plans are managed in the CMS.
                </p>
            )
        }
    </div>
</section>

<script>
    // Billing monthly / annual toggle
    const toggle = document.getElementById("billing-toggle");
    const knob = document.getElementById("billing-knob");
    const lblMonthly = document.getElementById("lbl-monthly");
    const lblAnnual = document.getElementById("lbl-annual");

    const setMode = (annual: boolean) => {
        toggle?.setAttribute("aria-checked", String(annual));
        knob?.classList.toggle("translate-x-5", annual);
        lblMonthly?.classList.toggle("text-brand-dark", !annual);
        lblMonthly?.classList.toggle("text-slate-400", annual);
        lblAnnual?.classList.toggle("text-brand-dark", annual);
        lblAnnual?.classList.toggle("text-slate-400", !annual);
        const key = annual ? "annual" : "monthly";
        document
            .querySelectorAll<HTMLElement>("[data-price], [data-billed]")
            .forEach((el) => {
                const val = el.dataset[key];
                if (val) el.textContent = val;
            });
    };
    toggle?.addEventListener("click", () =>
        setMode(toggle.getAttribute("aria-checked") !== "true"),
    );

    // See all plans
    const seeAll = document.getElementById("see-all-plans");
    seeAll?.addEventListener("click", () => {
        const expanded = seeAll.getAttribute("data-expanded") === "true";
        const next = !expanded;
        seeAll.setAttribute("data-expanded", String(next));
        document
            .querySelectorAll<HTMLElement>("#pricing-cards [data-extra]")
            .forEach((el) => el.classList.toggle("hidden", !next));
        const label = seeAll.querySelector("[data-label]");
        const count = seeAll.getAttribute("data-count");
        if (label) label.textContent = next ? "Show fewer" : `See all ${count} plans`;
        seeAll.querySelector("svg")?.classList.toggle("rotate-180", next);
    });
</script>
