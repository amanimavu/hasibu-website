---
import { Icon } from "astro-icon/components";
---

<section class="bg-white pb-20 lg:pb-28">
    <div class="mx-auto max-w-6xl px-6">
        <div
            class="flex flex-col gap-6 rounded-2xl bg-linear-to-r from-blue-50 to-blue-100/50 p-8 md:flex-row md:items-center md:justify-between lg:p-10"
        >
            <div>
                <h2 class="text-2xl font-bold text-brand-dark">
                    Ready to see Hasibu in action?
                </h2>
                <p class="mt-2 text-slate-500">
                    Join 2,400+ SMEs running smarter across Africa. Free for 14
                    days.
                </p>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row">
                <a
                    href="https://app.hasibu.africa/signup"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-brand px-6 py-3 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
                >
                    Start Free Trial
                    <Icon
                        name="material-symbols:arrow-forward-rounded"
                        class="size-4"
                    />
                </a>
                <a
                    href="/get-started/demo"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand"
                >
                    <Icon
                        name="material-symbols:calendar-month-outline"
                        class="size-4"
                    />
                    Book a Demo
                </a>
            </div>
        </div>
    </div>
</section>
