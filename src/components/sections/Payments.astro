---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import mpesa from "../../assets/images/integrations/mpesa.svg";
import uberEats from "../../assets/images/integrations/uber-eats.svg";
import mtn from "../../assets/images/integrations/mtn-momo.svg";
import bolt from "../../assets/images/integrations/bolt-food.svg";
import airtel from "../../assets/images/integrations/airtel-money.svg";
import kopokopo from "../../assets/images/integrations/kopokopo-symbol.svg";
import whatsapp from "../../assets/images/integrations/whatsapp.svg";
import pesapal from "../../assets/images/integrations/pesapal.svg";
import glovo from "../../assets/images/integrations/glovo.svg";

// Bento cards. `span` width follows each logo's aspect ratio so nothing is
// squished; M-Pesa is the 2x2 hero (headline payment rail). DOM order is tuned
// so `grid-flow-dense` packs the 6-col desktop grid with zero gaps.
const logos = [
    {
        name: "M-Pesa",
        img: mpesa,
        span: "col-span-2 row-span-1 lg:col-span-2 lg:row-span-2",
        imgClass: "max-h-12 lg:max-h-20",
    },
    {
        name: "Uber Eats",
        img: uberEats,
        span: "col-span-2 lg:col-span-3",
        imgClass: "max-h-9 lg:max-h-11",
    },
    {
        name: "MTN MoMo",
        img: mtn,
        span: "col-span-1",
        imgClass: "max-h-12 lg:max-h-14",
    },
    {
        name: "Bolt Food",
        img: bolt,
        span: "col-span-2",
        imgClass: "max-h-8 lg:max-h-10",
    },
    {
        name: "Airtel Money",
        img: airtel,
        span: "col-span-1",
        imgClass: "max-h-12 lg:max-h-14",
    },
    {
        name: "KopoKopo",
        img: kopokopo,
        span: "col-span-1",
        imgClass: "max-h-12 lg:max-h-14",
    },
    {
        name: "WhatsApp",
        img: whatsapp,
        span: "col-span-2",
        imgClass: "max-h-9 lg:max-h-11",
    },
    {
        name: "Pesapal",
        img: pesapal,
        span: "col-span-2",
        imgClass: "max-h-9 lg:max-h-11",
    },
    {
        name: "Glovo",
        img: glovo,
        span: "col-span-2",
        imgClass: "max-h-9 lg:max-h-11",
    },
];
---

<section class="bg-slate-50 py-20 lg:py-28">
    <div class="mx-auto max-w-5xl px-6">
        <!-- Heading -->
        <div class="text-center">
            <span
                class="inline-block rounded-full bg-blue-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-brand"
            >
                Payments &amp; Integrations
            </span>
            <h2
                class="mt-4 text-2xl font-bold tracking-tight text-brand-dark sm:text-3xl"
            >
                Plugs into the rails Africa already runs on.
            </h2>
            <p class="mx-auto mt-4 max-w-2xl text-slate-500">
                Mobile money, cards, tax compliance and delivery platforms,
                wired straight into Hasibu.
            </p>
        </div>

        <!-- Bento grid -->
        <div
            class="mt-12 grid grid-flow-dense auto-rows-[120px] grid-cols-2 gap-4 lg:auto-rows-[150px] lg:grid-cols-6"
        >
            {
                logos.map((l) => (
                    <div
                        class={`group flex items-center justify-center rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-brand hover:shadow-lg ${l.span}`}
                    >
                        <Image
                            src={l.img}
                            alt={l.name}
                            class={`w-auto object-contain opacity-80 transition group-hover:opacity-100 ${l.imgClass}`}
                            loading="lazy"
                        />
                    </div>
                ))
            }
        </div>

        <!-- CTA -->
        <div class="mt-12 text-center">
            <a
                href="/product/integrations/"
                class="group inline-flex items-center gap-2 rounded-lg border border-slate-200 px-6 py-3 text-sm font-medium text-brand-dark transition hover:border-brand hover:text-brand bg-white"
            >
                Explore all integrations
                <Icon
                    name="material-symbols:arrow-forward-rounded"
                    class="size-4 transition-transform group-hover:translate-x-1.5"
                />
            </a>
        </div>
    </div>
</section>
