---
import { Icon } from "astro-icon/components";

// Multi-location diagram. Accurate to the model: ONE business (tenant) holding
// typed locations — a stock-only Store and POS Shops — each with its OWN stock.
// Green connectors = stock transfers (store -> shops). Blue connectors = a sale
// whose lines route to different shops. Reports cycle location <-> consolidated.
// No HQ/franchise, no cross-business sharing.
---

<div class="mll w-full">
    <!-- Tenant boundary -->
    <div class="relative rounded-3xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
        <span
            class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-sm font-semibold text-brand-dark ring-1 ring-slate-200"
        >
            <Icon name="hugeicons:building-06" class="size-3.5 text-brand" />
            Riverside Duka
            <span class="font-normal text-slate-400">· one business</span>
        </span>

        <!-- Legend (top-left, per sketch) -->
        <div class="mt-3 space-y-1.5">
            <span class="flex items-center gap-2 text-[11px] text-slate-500">
                <span class="inline-block h-0.5 w-6 rounded bg-green-500"></span>
                Stock transfer
            </span>
            <span class="flex items-center gap-2 text-[11px] text-slate-500">
                <span class="inline-block h-0.5 w-6 rounded bg-brand"></span>
                Sale routing
            </span>
        </div>

        <!-- Diagram (desktop / tablet) -->
        <div class="relative mt-4 hidden aspect-[7/5] sm:block">
            <!-- Connectors -->
            <svg
                viewBox="0 0 300 214"
                preserveAspectRatio="none"
                class="pointer-events-none absolute inset-0 h-full w-full"
                aria-hidden="true"
            >
                <defs>
                    <marker id="ml-g" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto">
                        <path d="M0,0 L7,3.5 L0,7 Z" fill="#22c55e" />
                    </marker>
                    <marker id="ml-b" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto">
                        <path d="M0,0 L7,3.5 L0,7 Z" fill="#0066FF" />
                    </marker>
                </defs>
                <!-- Transfers: store -> shops (solid arrows, gap from cards) -->
                <path d="M150,52 L78,86" stroke="#22c55e" stroke-width="1.75" fill="none" marker-end="url(#ml-g)" />
                <path d="M150,52 L222,86" stroke="#22c55e" stroke-width="1.75" fill="none" marker-end="url(#ml-g)" />
                <!-- Sale routing: sale -> shops -->
                <path d="M150,176 L78,136" stroke="#0066FF" stroke-width="1.75" fill="none" marker-end="url(#ml-b)" />
                <path d="M150,176 L222,136" stroke="#0066FF" stroke-width="1.75" fill="none" marker-end="url(#ml-b)" />
                <!-- Flowing dots along each arrow -->
                <circle class="glide" r="2.5" fill="#22c55e" style="offset-path:path('M150,52 L78,86')" />
                <circle class="glide" r="2.5" fill="#22c55e" style="offset-path:path('M150,52 L222,86');animation-delay:.3s" />
                <circle class="glide" r="2.5" fill="#0066FF" style="offset-path:path('M150,176 L78,136');animation-delay:.6s" />
                <circle class="glide" r="2.5" fill="#0066FF" style="offset-path:path('M150,176 L222,136');animation-delay:.9s" />
            </svg>

            <!-- Store (stock only) -->
            <div class="node" style="left:50%;top:13%">
                <div class="node-head">
                    <span class="node-ico text-slate-500">
                        <Icon name="hugeicons:warehouse" class="size-4" />
                    </span>
                    <span class="node-title">Store</span>
                    <span class="node-tag bg-slate-100 text-slate-500">stock only</span>
                </div>
                <div class="node-body">
                    <p>On-hand <b>120</b></p>
                </div>
            </div>

            <!-- Shop A (POS) -->
            <div class="node" style="left:22%;top:52%">
                <div class="node-head">
                    <span class="node-ico text-brand">
                        <Icon name="hugeicons:store-01" class="size-4" />
                    </span>
                    <span class="node-title">Shop A</span>
                    <span class="node-tag bg-blue-50 text-brand">POS</span>
                </div>
                <div class="node-body">
                    <p>On-hand <b>45</b></p>
                    <p class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-green-500"></span>
                        M-Pesa till
                    </p>
                </div>
            </div>

            <!-- Shop B (POS) -->
            <div class="node" style="left:78%;top:52%">
                <div class="node-head">
                    <span class="node-ico text-brand">
                        <Icon name="hugeicons:store-01" class="size-4" />
                    </span>
                    <span class="node-title">Shop B</span>
                    <span class="node-tag bg-blue-50 text-brand">POS</span>
                </div>
                <div class="node-body">
                    <p>On-hand <b>32</b></p>
                    <p class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-green-500"></span>
                        M-Pesa till
                    </p>
                </div>
            </div>

            <!-- Sale (lines route to shops) -->
            <div class="node" style="left:50%;top:90%">
                <div class="node-head">
                    <span class="node-ico text-brand">
                        <Icon name="hugeicons:invoice-01" class="size-4" />
                    </span>
                    <span class="node-title">Sale #1042</span>
                </div>
                <div class="node-body">
                    <p>Each item routed to its shop</p>
                </div>
            </div>
        </div>

        <!-- Mobile: simple low-detail 3-step flow -->
        <div class="mt-4 flex flex-col items-stretch gap-2 sm:hidden">
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <span class="flex size-9 items-center justify-center rounded-lg bg-blue-50 text-brand">
                    <Icon name="hugeicons:store-01" class="size-5" />
                </span>
                <div>
                    <p class="text-sm font-semibold text-brand-dark">Shops & stores</p>
                    <p class="text-xs text-slate-400">One business, many locations</p>
                </div>
            </div>
            <Icon
                name="material-symbols:keyboard-arrow-down"
                class="mx-auto size-4 text-slate-300"
            />
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <span class="flex size-9 items-center justify-center rounded-lg bg-green-50 text-green-600">
                    <Icon name="hugeicons:package" class="size-5" />
                </span>
                <div>
                    <p class="text-sm font-semibold text-brand-dark">
                        Stock per location
                    </p>
                    <p class="text-xs text-slate-400">Transfer between them</p>
                </div>
            </div>
            <Icon
                name="material-symbols:keyboard-arrow-down"
                class="mx-auto size-4 text-slate-300"
            />
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <span class="flex size-9 items-center justify-center rounded-lg bg-blue-50 text-brand">
                    <Icon name="hugeicons:dashboard-square-02" class="size-5" />
                </span>
                <div>
                    <p class="text-sm font-semibold text-brand-dark">
                        One rolled-up view
                    </p>
                    <p class="text-xs text-slate-400">Per branch or consolidated</p>
                </div>
            </div>
        </div>

        <!-- Reports rollup (cycles location <-> consolidated) + legend -->
        <div class="mt-4 flex items-center justify-between gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
            <div class="flex items-center gap-2">
                <Icon name="hugeicons:dashboard-square-02" class="size-4 text-brand" />
                <span class="text-sm font-semibold text-brand-dark">Reports</span>
            </div>
            <div class="rep text-right text-xs">
                <div class="rep-list">
                    <div class="rep-row">
                        <span class="text-slate-400">Shop A</span>
                        <span class="ml-1 font-semibold text-brand-dark">Ksh 84,200</span>
                    </div>
                    <div class="rep-row">
                        <span class="text-slate-400">Shop B</span>
                        <span class="ml-1 font-semibold text-brand-dark">Ksh 61,900</span>
                    </div>
                    <div class="rep-row">
                        <span class="text-brand">All locations</span>
                        <span class="ml-1 font-semibold text-brand-dark">Ksh 210,600</span>
                    </div>
                    <div class="rep-row">
                        <span class="text-slate-400">Shop A</span>
                        <span class="ml-1 font-semibold text-brand-dark">Ksh 84,200</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .node {
        position: absolute;
        transform: translate(-50%, -50%);
        width: 44%;
        max-width: 12rem;
        border-radius: 0.875rem;
        background: #fff;
        overflow: hidden;
        box-shadow:
            0 2px 6px rgba(15, 23, 42, 0.08),
            0 0 0 1px rgb(226 232 240);
    }
    /* Header row: icon-in-a-box + title, tag on the right, divider below. */
    .node-head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 0.75rem;
        border-bottom: 1px solid rgb(226 232 240);
    }
    .node-ico {
        display: flex;
        flex: none;
        align-items: center;
        justify-content: center;
    }
    .node-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-brand-dark);
        white-space: nowrap;
    }
    .node-tag {
        margin-left: auto;
        border-radius: 0.375rem;
        padding: 0.1rem 0.4rem;
        font-size: 0.625rem;
        font-weight: 600;
        white-space: nowrap;
    }
    /* Body: detail lines. */
    .node-body {
        padding: 0.55rem 0.75rem;
        font-size: 0.75rem;
        line-height: 1.1rem;
        color: rgb(100 116 139);
    }
    .node-body b {
        font-weight: 600;
        color: var(--color-brand-dark);
    }

    /* Dot glides along each arrow to show flow direction. */
    .glide {
        offset-distance: 0%;
        animation: mll-glide 1.8s linear infinite;
    }
    @keyframes mll-glide {
        to {
            offset-distance: 100%;
        }
    }

    /* Reports: cycle location -> location -> consolidated. */
    .rep {
        height: 1rem;
        overflow: hidden;
    }
    .rep-list {
        animation: mll-rep 7s cubic-bezier(0.7, 0, 0.3, 1) infinite;
    }
    .rep-row {
        height: 1rem;
        line-height: 1rem;
        white-space: nowrap;
    }
    @keyframes mll-rep {
        0%, 22% { transform: translateY(0); }
        28%, 55% { transform: translateY(-25%); }
        61%, 88% { transform: translateY(-50%); }
        94%, 100% { transform: translateY(-75%); }
    }

    @media (prefers-reduced-motion: reduce) {
        .glide,
        .rep-list {
            animation: none;
        }
    }
</style>
