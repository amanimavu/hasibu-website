---
import { Image } from "astro:assets";
import mpesa from "../assets/images/integrations/mpesa.svg";
import airtel from "../assets/images/integrations/airtel-money.svg";
import mtn from "../assets/images/integrations/mtn-momo.svg";
import pesapal from "../assets/images/integrations/pesapal.svg";
import uberEats from "../assets/images/integrations/uber-eats.svg";
import bolt from "../assets/images/integrations/bolt-food.svg";
import glovo from "../assets/images/integrations/glovo.svg";
import whatsapp from "../assets/images/integrations/whatsapp.svg";

// Real integrations wired into Hasibu, placed on a ring; tokens flow inward.
const logos = [
    { name: "M-Pesa", img: mpesa },
    { name: "Airtel Money", img: airtel },
    { name: "MTN MoMo", img: mtn },
    { name: "Pesapal", img: pesapal },
    { name: "Uber Eats", img: uberEats },
    { name: "Bolt Food", img: bolt },
    { name: "Glovo", img: glovo },
    { name: "WhatsApp", img: whatsapp },
];

// Ring positions (percent of the box). Start at the top, go clockwise.
const R = 39;
const items = logos.map((l, i) => {
    const a = (i / logos.length) * 2 * Math.PI - Math.PI / 2;
    return { ...l, x: 50 + R * Math.cos(a), y: 50 + R * Math.sin(a) };
});
---

<div class="ihub w-full">
    <div>
        <!-- Desktop: hub-and-spoke -->
        <div class="relative mt-4 hidden aspect-[6/5] sm:block">
            <!-- Connections + inbound tokens -->
            <svg
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                class="pointer-events-none absolute inset-0 h-full w-full"
                aria-hidden="true"
            >
                {
                    items.map((it, i) => (
                        <Fragment>
                            <line
                                x1={it.x}
                                y1={it.y}
                                x2="50"
                                y2="50"
                                stroke="#cbd5e1"
                                stroke-width="0.4"
                            />
                            <circle
                                class="tok"
                                r="1.1"
                                fill="#0066FF"
                                style={`offset-path:path('M ${it.x} ${it.y} L 50 50');animation-delay:${(i * 0.3).toFixed(2)}s`}
                            />
                        </Fragment>
                    ))
                }
            </svg>

            <!-- Logo nodes -->
            {
                items.map((it) => (
                    <div
                        class="absolute z-10 flex size-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white p-3 shadow-md ring-1 ring-slate-200"
                        style={`left:${it.x}%;top:${it.y}%`}
                    >
                        <Image
                            src={it.img}
                            alt={it.name}
                            class="max-h-8 w-auto max-w-12 object-contain"
                            loading="lazy"
                        />
                    </div>
                ))
            }

            <!-- Center: Hasibu (mark inlined so each glyph animates) -->
            <div
                class="absolute left-1/2 top-1/2 z-20 flex size-28 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-brand-dark shadow-xl"
                role="img"
                aria-label="Hasibu"
            >
                <svg
                    class="m-mark size-14"
                    viewBox="0 0 256 256"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        class="m-glyph m-circle"
                        d="M64 117.333C93.4552 117.333 117.333 93.4552 117.333 64C117.333 34.5448 93.4552 10.6667 64 10.6667C34.5448 10.6667 10.6667 34.5448 10.6667 64C10.6667 93.4552 34.5448 117.333 64 117.333Z"
                        fill="#0066FF"
                    />
                    <path
                        class="m-glyph m-square"
                        d="M101.333 144H26.6667C20.7756 144 16 148.776 16 154.667V229.333C16 235.224 20.7756 240 26.6667 240H101.333C107.224 240 112 235.224 112 229.333V154.667C112 148.776 107.224 144 101.333 144Z"
                        fill="#0066FF"
                    />
                    <path
                        class="m-glyph m-tri"
                        d="M182.88 20.5867L137.707 96C136.775 97.6129 136.282 99.4416 136.277 101.304C136.272 103.167 136.755 104.998 137.677 106.616C138.599 108.234 139.929 109.583 141.534 110.527C143.14 111.472 144.964 111.98 146.827 112H237.173C239.036 111.98 240.86 111.472 242.465 110.527C244.071 109.583 245.401 108.234 246.323 106.616C247.245 104.998 247.728 103.167 247.723 101.304C247.717 99.4416 247.225 97.6129 246.293 96L201.12 20.5867C200.169 19.0192 198.83 17.7233 197.233 16.8239C195.635 15.9245 193.833 15.452 192 15.452C190.167 15.452 188.364 15.9245 186.767 16.8239C185.169 17.7233 183.831 19.0192 182.88 20.5867Z"
                        fill="#0066FF"
                    />
                    <g class="m-x">
                        <path
                            d="M240 144L144 240"
                            stroke="#ECF0F3"
                            stroke-width="16"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                        <path
                            d="M144 144L240 240"
                            stroke="#ECF0F3"
                            stroke-width="16"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </g>
                </svg>
            </div>
        </div>

        <!-- Mobile: simple logo cloud -->
        <div class="mt-4 sm:hidden">
            <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4 rounded-2xl bg-white p-5 ring-1 ring-slate-200">
                {
                    logos.map((l) => (
                        <Image
                            src={l.img}
                            alt={l.name}
                            class="h-5 w-auto max-w-16 object-contain opacity-70"
                            loading="lazy"
                        />
                    ))
                }
            </div>
            <p class="mt-3 text-center text-xs text-slate-400">
                All wired into Hasibu, scoped per location
            </p>
        </div>
    </div>
</div>

<style>
    /* Tokens glide from each logo into Hasibu. */
    .tok {
        offset-distance: 0%;
        animation: tok-flow 2.6s linear infinite;
    }
    @keyframes tok-flow {
        to {
            offset-distance: 100%;
        }
    }
    /* Center mark assembles once on view: circle, triangle, square, then the X
       draws in. Snappy pop with a little overshoot. */
    .m-glyph {
        transform-box: fill-box;
        transform-origin: center;
        opacity: 0;
        transform: scale(0.5);
    }
    .m-x path {
        stroke-dasharray: 136;
        stroke-dashoffset: 136;
    }
    .m-mark.in .m-circle {
        animation: g-pop 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    .m-mark.in .m-tri {
        animation: g-pop 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.16s forwards;
    }
    .m-mark.in .m-square {
        animation: g-pop 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.32s forwards;
    }
    .m-mark.in .m-x path {
        animation: x-draw 0.4s ease-out 0.5s forwards;
    }
    @keyframes g-pop {
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
    @keyframes x-draw {
        to {
            stroke-dashoffset: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .tok {
            animation: none;
            opacity: 0;
        }
        .m-glyph {
            opacity: 1;
            transform: none;
        }
        .m-x path {
            stroke-dashoffset: 0;
        }
        .m-mark.in .m-circle,
        .m-mark.in .m-tri,
        .m-mark.in .m-square,
        .m-mark.in .m-x path {
            animation: none;
        }
    }
</style>

<script>
    // Play the mark assembly whenever the hub scrolls into view; reset on leave
    // so it replays on re-entry.
    const marks = document.querySelectorAll<SVGElement>(".ihub .m-mark");
    for (const mark of marks) {
        const io = new IntersectionObserver(
            (entries) => {
                for (const e of entries) {
                    if (e.isIntersecting) {
                        mark.classList.remove("in");
                        void mark.getBoundingClientRect(); // reflow to restart
                        mark.classList.add("in");
                    } else {
                        mark.classList.remove("in");
                    }
                }
            },
            { threshold: 0.4 },
        );
        io.observe(mark);
    }
</script>
