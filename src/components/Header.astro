---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import brandLogo from "../assets/images/brand/hasibu-brand-black.svg";
import { industries, roles } from "../data/solutions";
import { SIGNUP_URL, LOGIN_URL } from "../lib/site";
import { moduleGroups } from "../data/modules";

// Simple nav links (Product, Solutions and Resources have their own mega menus).
const nav = [
    { href: "/pricing", label: "Pricing" },
    { href: "/company/about", label: "Company" },
];

// Product mega menu: canonical module list (shared with /product and the footer).
const mega = moduleGroups;

// Solutions mega menu: two axes, sourced from the solutions data.
const solutionsMega = [
    {
        title: "By industry",
        color: "text-green-600",
        icon: "hugeicons:store-01",
        items: industries.map((s) => ({
            label: s.name,
            href: `/solutions/${s.slug}`,
            icon: s.icon,
        })),
    },
    {
        title: "By role",
        color: "text-blue-600",
        icon: "hugeicons:user-group",
        items: roles.map((s) => ({
            label: s.name,
            href: `/solutions/${s.slug}`,
            icon: s.icon,
        })),
    },
];

// Resources mega menu.
const resourcesMega = [
    {
        title: "Learn",
        color: "text-purple-600",
        icon: "hugeicons:book-open-01",
        items: [
            {
                label: "Blog",
                href: "/resources/blog",
                icon: "hugeicons:news-01",
            },
            {
                label: "Guides & Tutorials",
                href: "/resources/guides",
                icon: "hugeicons:mortarboard-02",
            },
        ],
    },
    {
        title: "Support & updates",
        color: "text-teal-600",
        icon: "hugeicons:customer-support",
        items: [
            {
                label: "Help Center",
                href: "/resources/help",
                icon: "hugeicons:help-circle",
            },
            {
                label: "Changelog",
                href: "/resources/changelog",
                icon: "hugeicons:megaphone-01",
            },
        ],
    },
];
---

<header
    id="site-header"
    class="fixed top-0 z-50 w-full backdrop-blur-md transition-colors duration-300"
>
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" aria-label="Hasibu home" class="text-brand-dark">
            <Image src={brandLogo} alt="Hasibu Logo" width="150" />
        </a>

        <!-- Desktop nav -->
        <nav class="hidden items-center gap-8 lg:flex">
            <button
                id="product-trigger"
                type="button"
                aria-controls="mega-product"
                aria-expanded="false"
                class="inline-flex items-center gap-0.5 text-sm font-medium text-slate-600 transition hover:text-brand aria-expanded:text-brand"
            >
                Product
                <Icon
                    id="product-caret"
                    name="material-symbols:keyboard-arrow-down"
                    class="size-4 text-slate-400 transition-transform"
                />
            </button>
            <button
                id="solutions-trigger"
                type="button"
                aria-controls="mega-solutions"
                aria-expanded="false"
                class="inline-flex items-center gap-0.5 text-sm font-medium text-slate-600 transition hover:text-brand aria-expanded:text-brand"
            >
                Solutions
                <Icon
                    id="solutions-caret"
                    name="material-symbols:keyboard-arrow-down"
                    class="size-4 text-slate-400 transition-transform"
                />
            </button>
            <button
                id="resources-trigger"
                type="button"
                aria-controls="mega-resources"
                aria-expanded="false"
                class="inline-flex items-center gap-0.5 text-sm font-medium text-slate-600 transition hover:text-brand aria-expanded:text-brand"
            >
                Resources
                <Icon
                    id="resources-caret"
                    name="material-symbols:keyboard-arrow-down"
                    class="size-4 text-slate-400 transition-transform"
                />
            </button>
            {
                nav.map((n) => (
                    <a
                        href={n.href}
                        class="text-sm font-medium text-slate-600 transition hover:text-brand"
                    >
                        {n.label}
                    </a>
                ))
            }
        </nav>

        <!-- Desktop actions -->
        <div class="hidden items-center gap-5 lg:flex">
            <a
                href={LOGIN_URL}
                class="text-sm font-medium text-slate-600 transition hover:text-brand hover:border-brand px-4 py-2 border rounded-lg border-neutral-400"
            >
                Login
            </a>
            <a
                href={SIGNUP_URL}
                class="rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
            >
                Get Started
            </a>
        </div>

        <!-- Mobile menu trigger -->
        <button
            id="menu-open"
            type="button"
            aria-label="Open menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
            class="text-slate-700 lg:hidden"
        >
            <Icon name="material-symbols:menu" class="size-7" />
        </button>
    </div>

    <!-- Product mega menu (desktop) -->
    <div
        id="mega-product"
        class="invisible absolute left-0 top-full hidden w-full opacity-0 transition-opacity duration-200 lg:block"
    >
        <div class="border-t border-slate-100 bg-white shadow-xl">
            <div class="mx-auto grid max-w-6xl grid-cols-5 gap-8 px-6 py-8">
                {
                    mega.map((col) => (
                        <div>
                            <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                                <Icon
                                    name={col.icon}
                                    class={`size-4 ${col.color}`}
                                />
                                <span
                                    class={`text-xs font-semibold uppercase tracking-wide ${col.color}`}
                                >
                                    {col.title}
                                </span>
                            </div>
                            <ul class="mt-4 space-y-3">
                                {col.items.map((it) => (
                                    <li>
                                        <a
                                            href={it.href}
                                            class="flex items-center gap-2 text-sm text-slate-600 transition hover:text-brand"
                                        >
                                            <Icon
                                                name={it.icon}
                                                class="size-4 text-slate-400"
                                            />
                                            {it.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <!-- Solutions mega menu (desktop) -->
    <div
        id="mega-solutions"
        class="invisible absolute left-0 top-full hidden w-full opacity-0 transition-opacity duration-200 lg:block"
    >
        <div class="border-t border-slate-100 bg-white shadow-xl">
            <div class="mx-auto grid max-w-4xl grid-cols-2 gap-8 px-6 py-8">
                {
                    solutionsMega.map((col) => (
                        <div>
                            <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                                <Icon
                                    name={col.icon}
                                    class={`size-4 ${col.color}`}
                                />
                                <span
                                    class={`text-xs font-semibold uppercase tracking-wide ${col.color}`}
                                >
                                    {col.title}
                                </span>
                            </div>
                            <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3">
                                {col.items.map((it) => (
                                    <li>
                                        <a
                                            href={it.href}
                                            class="flex items-center gap-2 text-sm text-slate-600 transition hover:text-brand"
                                        >
                                            <Icon
                                                name={it.icon}
                                                class="size-4 text-slate-400"
                                            />
                                            {it.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <!-- Resources mega menu (desktop) -->
    <div
        id="mega-resources"
        class="invisible absolute left-0 top-full hidden w-full opacity-0 transition-opacity duration-200 lg:block"
    >
        <div class="border-t border-slate-100 bg-white shadow-xl">
            <div class="mx-auto grid max-w-3xl grid-cols-2 gap-8 px-6 py-8">
                {
                    resourcesMega.map((col) => (
                        <div>
                            <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                                <Icon
                                    name={col.icon}
                                    class={`size-4 ${col.color}`}
                                />
                                <span
                                    class={`text-xs font-semibold uppercase tracking-wide ${col.color}`}
                                >
                                    {col.title}
                                </span>
                            </div>
                            <ul class="mt-4 space-y-3">
                                {col.items.map((it) => (
                                    <li>
                                        <a
                                            href={it.href}
                                            class="flex items-center gap-2 text-sm text-slate-600 transition hover:text-brand"
                                        >
                                            <Icon
                                                name={it.icon}
                                                class="size-4 text-slate-400"
                                            />
                                            {it.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</header>

<!-- Mobile nav drawer -->
<div
    id="mobile-menu"
    class="invisible fixed inset-0 z-[60] lg:hidden"
    aria-hidden="true"
>
    <div
        id="menu-overlay"
        class="absolute inset-0 bg-black/30 opacity-0 backdrop-blur-xs transition-opacity duration-300"
    >
    </div>
    <aside
        id="menu-panel"
        class="absolute right-0 top-0 flex h-full w-72 max-w-[80%] translate-x-full flex-col overflow-y-auto overscroll-contain bg-white p-6 shadow-xl transition-transform duration-300"
    >
        <div class="flex justify-end">
            <button
                id="menu-close"
                type="button"
                aria-label="Close menu"
                class="text-slate-500 transition hover:text-brand-dark"
            >
                <Icon name="material-symbols:close" class="size-6" />
            </button>
        </div>

        <nav class="mt-8 flex flex-col">
            <!-- Product (collapsible, mirrors the desktop mega menu) -->
            <details class="group border-b border-slate-100">
                <summary
                    class="flex cursor-pointer list-none items-center justify-between py-3 text-base font-medium text-slate-700 transition hover:text-brand [&::-webkit-details-marker]:hidden"
                >
                    Product
                    <Icon
                        name="material-symbols:keyboard-arrow-down"
                        class="size-5 text-slate-400 transition-transform group-open:rotate-180"
                    />
                </summary>
                <div class="pb-4">
                    {
                        mega.map((col) => (
                            <div class="mt-5 first:mt-3">
                                <span
                                    class={`flex items-center gap-2 text-xs font-semibold uppercase tracking-wide ${col.color}`}
                                >
                                    <Icon name={col.icon} class="size-4" />
                                    {col.title}
                                </span>
                                <ul class="mt-2 space-y-1 pl-6">
                                    {col.items.map((it) => (
                                        <li>
                                            <a
                                                href={it.href}
                                                data-nav-link
                                                class="flex items-center gap-2 py-1.5 text-sm text-slate-600 transition hover:text-brand"
                                            >
                                                <Icon
                                                    name={it.icon}
                                                    class="size-4 text-slate-400"
                                                />
                                                {it.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </details>
            <!-- Solutions (collapsible, mirrors the desktop mega menu) -->
            <details class="group border-b border-slate-100">
                <summary
                    class="flex cursor-pointer list-none items-center justify-between py-3 text-base font-medium text-slate-700 transition hover:text-brand [&::-webkit-details-marker]:hidden"
                >
                    Solutions
                    <Icon
                        name="material-symbols:keyboard-arrow-down"
                        class="size-5 text-slate-400 transition-transform group-open:rotate-180"
                    />
                </summary>
                <div class="pb-4">
                    {
                        solutionsMega.map((col) => (
                            <div class="mt-5 first:mt-3">
                                <span
                                    class={`flex items-center gap-2 text-xs font-semibold uppercase tracking-wide ${col.color}`}
                                >
                                    <Icon name={col.icon} class="size-4" />
                                    {col.title}
                                </span>
                                <ul class="mt-2 space-y-1 pl-6">
                                    {col.items.map((it) => (
                                        <li>
                                            <a
                                                href={it.href}
                                                data-nav-link
                                                class="flex items-center gap-2 py-1.5 text-sm text-slate-600 transition hover:text-brand"
                                            >
                                                <Icon
                                                    name={it.icon}
                                                    class="size-4 text-slate-400"
                                                />
                                                {it.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </details>
            <!-- Resources (collapsible, mirrors the desktop mega menu) -->
            <details class="group border-b border-slate-100">
                <summary
                    class="flex cursor-pointer list-none items-center justify-between py-3 text-base font-medium text-slate-700 transition hover:text-brand [&::-webkit-details-marker]:hidden"
                >
                    Resources
                    <Icon
                        name="material-symbols:keyboard-arrow-down"
                        class="size-5 text-slate-400 transition-transform group-open:rotate-180"
                    />
                </summary>
                <div class="pb-4">
                    {
                        resourcesMega.map((col) => (
                            <div class="mt-5 first:mt-3">
                                <span
                                    class={`flex items-center gap-2 text-xs font-semibold uppercase tracking-wide ${col.color}`}
                                >
                                    <Icon name={col.icon} class="size-4" />
                                    {col.title}
                                </span>
                                <ul class="mt-2 space-y-1 pl-6">
                                    {col.items.map((it) => (
                                        <li>
                                            <a
                                                href={it.href}
                                                data-nav-link
                                                class="flex items-center gap-2 py-1.5 text-sm text-slate-600 transition hover:text-brand"
                                            >
                                                <Icon
                                                    name={it.icon}
                                                    class="size-4 text-slate-400"
                                                />
                                                {it.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </details>
            {
                nav.map((n) => (
                    <a
                        href={n.href}
                        data-nav-link
                        class="border-b border-slate-100 py-3 text-base font-medium text-slate-700 transition hover:text-brand"
                    >
                        {n.label}
                    </a>
                ))
            }
        </nav>

        <div class="mt-6 flex flex-col gap-3">
            <a
                href={LOGIN_URL}
                data-nav-link
                class="rounded-lg border border-neutral-400 px-4 py-2.5 text-center text-sm font-medium text-slate-600 transition hover:text-brand hover:border-brand"
            >
                Login
            </a>
            <a
                href={SIGNUP_URL}
                data-nav-link
                class="rounded-lg bg-brand px-4 py-2.5 text-center text-sm font-medium text-white shadow-sm transition hover:opacity-90"
            >
                Get Started
            </a>
        </div>
    </aside>
</div>

<style>
    /* At top: transparent so the bar reads as part of the hero.
       After scroll: opaque white so nav stays legible over dark sections. */
    #site-header {
        background-color: transparent;
    }
    #site-header.scrolled {
        background-color: rgb(255 255 255 / 0.9);
        border-bottom: 1px solid var(--color-neutral-200);
        box-shadow: 0 4px 16px rgb(0 102 255 / 0.08);
    }
</style>

<script>
    const header = document.getElementById("site-header");
    const sync = () => header?.classList.toggle("scrolled", window.scrollY > 8);
    sync();
    window.addEventListener("scroll", sync, { passive: true });

    // Mobile nav drawer
    const menu = document.getElementById("mobile-menu");
    const panel = document.getElementById("menu-panel");
    const openBtn = document.getElementById("menu-open");
    const closeBtn = document.getElementById("menu-close");
    const overlay = document.getElementById("menu-overlay");

    const open = () => {
        menu?.classList.remove("invisible");
        // next frame so the opacity transition runs from 0
        requestAnimationFrame(() => overlay?.classList.remove("opacity-0"));
        panel?.classList.remove("translate-x-full");
        menu?.setAttribute("aria-hidden", "false");
        openBtn?.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
    };
    const close = () => {
        overlay?.classList.add("opacity-0");
        panel?.classList.add("translate-x-full");
        menu?.setAttribute("aria-hidden", "true");
        openBtn?.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        // wait for fade/slide to finish before removing from hit-testing
        setTimeout(() => menu?.classList.add("invisible"), 300);
    };

    openBtn?.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    overlay?.addEventListener("click", close);
    menu?.querySelectorAll("[data-nav-link]").forEach((link) =>
        link.addEventListener("click", close),
    );
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
    });

    // Desktop mega menus (Product, Solutions). Each trigger opens its own panel;
    // opening one closes the others.
    const wireMega = (triggerId: string, megaId: string, caretId: string) => {
        const trigger = document.getElementById(triggerId);
        const mega = document.getElementById(megaId);
        const caret = document.getElementById(caretId);
        if (!trigger || !mega) return null;
        let timer: ReturnType<typeof setTimeout>;

        const openM = () => {
            clearTimeout(timer);
            closeOthers(megaId);
            mega.classList.remove("invisible");
            requestAnimationFrame(() => mega.classList.remove("opacity-0"));
            trigger.setAttribute("aria-expanded", "true");
            caret?.classList.add("rotate-180");
        };
        const closeM = () => {
            mega.classList.add("opacity-0");
            trigger.setAttribute("aria-expanded", "false");
            caret?.classList.remove("rotate-180");
            timer = setTimeout(() => mega.classList.add("invisible"), 200);
        };
        // small delay so the gap between trigger and panel doesn't close it
        const scheduleClose = () => {
            timer = setTimeout(closeM, 150);
        };

        trigger.addEventListener("mouseenter", openM);
        trigger.addEventListener("mouseleave", scheduleClose);
        trigger.addEventListener("focus", openM);
        mega.addEventListener("mouseenter", () => clearTimeout(timer));
        mega.addEventListener("mouseleave", scheduleClose);
        trigger.addEventListener("click", () =>
            trigger.getAttribute("aria-expanded") === "true"
                ? closeM()
                : openM(),
        );
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeM();
        });
        document.addEventListener("click", (e) => {
            const t = e.target as Node;
            if (!trigger.contains(t) && !mega.contains(t)) closeM();
        });
        return { id: megaId, close: closeM };
    };

    const megas: Array<{ id: string; close: () => void }> = [];
    const closeOthers = (keepId: string) =>
        megas.forEach((m) => m.id !== keepId && m.close());

    [
        wireMega("product-trigger", "mega-product", "product-caret"),
        wireMega("solutions-trigger", "mega-solutions", "solutions-caret"),
        wireMega("resources-trigger", "mega-resources", "resources-caret"),
    ].forEach((m) => m && megas.push(m));
</script>
