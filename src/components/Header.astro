---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import brandLogo from "../assets/images/brand/official-banner.svg";

// Simple nav links (Product has its own mega menu, handled separately).
const nav = [
    { href: "/solutions", label: "Solutions" },
    { href: "/pricing", label: "Pricing" },
    { href: "/resources/blog", label: "Resources" },
    { href: "/company/about", label: "Company" },
];

// Product mega menu: 4 columns.
const mega = [
    {
        title: "Core Operations",
        color: "text-green-600",
        icon: "hugeicons:store-01",
        items: [
            {
                label: "Point of Sale (POS)",
                href: "/product/pos",
                icon: "hugeicons:shopping-cart-01",
            },
            {
                label: "Inventory & Stock",
                href: "/product/inventory",
                icon: "hugeicons:package",
            },
            {
                label: "Multi-Location",
                href: "/product/multi-location",
                icon: "hugeicons:location-01",
            },
        ],
    },
    {
        title: "Finance & Commerce",
        color: "text-orange-500",
        icon: "hugeicons:analytics-up",
        items: [
            {
                label: "Accounting & GL",
                href: "/product/accounting",
                icon: "hugeicons:invoice-01",
            },
            {
                label: "eCommerce / Storefront",
                href: "/product/online-store",
                icon: "hugeicons:hand-bag-01",
            },
            {
                label: "Reports & Analytics",
                href: "/product/reports",
                icon: "hugeicons:analytics-01",
            },
            {
                label: "Payroll",
                href: "/product/payroll",
                icon: "hugeicons:wallet-01",
            },
        ],
    },
    {
        title: "B2B & Supply",
        color: "text-blue-600",
        icon: "hugeicons:delivery-truck-01",
        items: [
            {
                label: "Hasibu Trade Network",
                href: "/product/trade",
                icon: "hugeicons:distribution",
            },
            {
                label: "Supplier Portal",
                href: "/product/supplier-portal",
                icon: "hugeicons:delivery-box-01",
            },
        ],
    },
    {
        title: "Productivity",
        color: "text-purple-600",
        icon: "hugeicons:flash",
        items: [
            {
                label: "Integrations",
                href: "/integrations",
                icon: "hugeicons:plug-01",
            },
        ],
    },
];
---

<header
    id="site-header"
    class="fixed top-0 z-50 w-full backdrop-blur-md transition-colors duration-300"
>
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" aria-label="Hasibu home" class="text-brand-dark">
            <Image src={brandLogo} alt="Hasibu Logo" width="150" />
        </a>

        <!-- Desktop nav -->
        <nav class="hidden items-center gap-8 lg:flex">
            <button
                id="product-trigger"
                type="button"
                aria-controls="mega-product"
                aria-expanded="false"
                class="inline-flex items-center gap-0.5 text-sm font-medium text-slate-600 transition hover:text-brand aria-expanded:text-brand"
            >
                Product
                <Icon
                    id="product-caret"
                    name="material-symbols:keyboard-arrow-down"
                    class="size-4 text-slate-400 transition-transform"
                />
            </button>
            {
                nav.map((n) => (
                    <a
                        href={n.href}
                        class="text-sm font-medium text-slate-600 transition hover:text-brand"
                    >
                        {n.label}
                    </a>
                ))
            }
        </nav>

        <!-- Desktop actions -->
        <div class="hidden items-center gap-5 lg:flex">
            <a
                href="https://app.hasibu.africa/login"
                class="text-sm font-medium text-slate-600 transition hover:text-brand px-4 py-2 border rounded-lg border-neutral-400"
            >
                Login
            </a>
            <a
                href="https://app.hasibu.africa/signup"
                class="rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
            >
                Get Started
            </a>
        </div>

        <!-- Mobile menu trigger -->
        <button
            id="menu-open"
            type="button"
            aria-label="Open menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
            class="text-slate-700 lg:hidden"
        >
            <Icon name="material-symbols:menu" class="size-7" />
        </button>
    </div>

    <!-- Product mega menu (desktop) -->
    <div
        id="mega-product"
        class="invisible absolute left-0 top-full hidden w-full opacity-0 transition-opacity duration-200 lg:block"
    >
        <div class="border-t border-slate-100 bg-white shadow-xl">
            <div class="mx-auto grid max-w-6xl grid-cols-4 gap-8 px-6 py-8">
                {
                    mega.map((col) => (
                        <div>
                            <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                                <Icon
                                    name={col.icon}
                                    class={`size-4 ${col.color}`}
                                />
                                <span
                                    class={`text-xs font-semibold uppercase tracking-wide ${col.color}`}
                                >
                                    {col.title}
                                </span>
                            </div>
                            <ul class="mt-4 space-y-3">
                                {col.items.map((it) => (
                                    <li>
                                        <a
                                            href={it.href}
                                            class="flex items-center gap-2 text-sm text-slate-600 transition hover:text-brand"
                                        >
                                            <Icon
                                                name={it.icon}
                                                class="size-4 text-slate-400"
                                            />
                                            {it.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</header>

<!-- Mobile nav drawer -->
<div
    id="mobile-menu"
    class="invisible fixed inset-0 z-[60] lg:hidden"
    aria-hidden="true"
>
    <div
        id="menu-overlay"
        class="absolute inset-0 bg-black/30 opacity-0 backdrop-blur-xs transition-opacity duration-300"
    >
    </div>
    <aside
        id="menu-panel"
        class="absolute right-0 top-0 flex h-full w-72 max-w-[80%] translate-x-full flex-col bg-white p-6 shadow-xl transition-transform duration-300"
    >
        <div class="flex justify-end">
            <button
                id="menu-close"
                type="button"
                aria-label="Close menu"
                class="text-slate-500 transition hover:text-brand-dark"
            >
                <Icon name="material-symbols:close" class="size-6" />
            </button>
        </div>

        <nav class="mt-8 flex flex-col">
            {
                nav.map((n) => (
                    <a
                        href={n.href}
                        data-nav-link
                        class="border-b border-slate-100 py-3 text-base font-medium text-slate-700 transition hover:text-brand"
                    >
                        {n.label}
                    </a>
                ))
            }
        </nav>

        <div class="mt-6 flex flex-col gap-3">
            <a
                href="https://app.hasibu.africa/login"
                data-nav-link
                class="rounded-lg border border-neutral-400 px-4 py-2.5 text-center text-sm font-medium text-slate-600 transition hover:text-brand"
            >
                Login
            </a>
            <a
                href="https://app.hasibu.africa/signup"
                data-nav-link
                class="rounded-lg bg-brand px-4 py-2.5 text-center text-sm font-medium text-white shadow-sm transition hover:opacity-90"
            >
                Get Started
            </a>
        </div>
    </aside>
</div>

<style>
    /* At top: transparent so the bar reads as part of the hero.
       After scroll: opaque white so nav stays legible over dark sections. */
    #site-header {
        background-color: transparent;
    }
    #site-header.scrolled {
        background-color: rgb(255 255 255 / 0.9);
        border-bottom: 1px solid var(--color-neutral-200);
        box-shadow: 0 4px 16px rgb(0 102 255 / 0.08);
    }
</style>

<script>
    const header = document.getElementById("site-header");
    const sync = () => header?.classList.toggle("scrolled", window.scrollY > 8);
    sync();
    window.addEventListener("scroll", sync, { passive: true });

    // Mobile nav drawer
    const menu = document.getElementById("mobile-menu");
    const panel = document.getElementById("menu-panel");
    const openBtn = document.getElementById("menu-open");
    const closeBtn = document.getElementById("menu-close");
    const overlay = document.getElementById("menu-overlay");

    const open = () => {
        menu?.classList.remove("invisible");
        // next frame so the opacity transition runs from 0
        requestAnimationFrame(() => overlay?.classList.remove("opacity-0"));
        panel?.classList.remove("translate-x-full");
        menu?.setAttribute("aria-hidden", "false");
        openBtn?.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
    };
    const close = () => {
        overlay?.classList.add("opacity-0");
        panel?.classList.add("translate-x-full");
        menu?.setAttribute("aria-hidden", "true");
        openBtn?.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        // wait for fade/slide to finish before removing from hit-testing
        setTimeout(() => menu?.classList.add("invisible"), 300);
    };

    openBtn?.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    overlay?.addEventListener("click", close);
    menu?.querySelectorAll("[data-nav-link]").forEach((link) =>
        link.addEventListener("click", close),
    );
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
    });

    // Product mega menu (desktop)
    const trigger = document.getElementById("product-trigger");
    const mega = document.getElementById("mega-product");
    const caret = document.getElementById("product-caret");
    let megaTimer: ReturnType<typeof setTimeout>;

    const megaOpen = () => {
        clearTimeout(megaTimer);
        mega?.classList.remove("invisible");
        requestAnimationFrame(() => mega?.classList.remove("opacity-0"));
        trigger?.setAttribute("aria-expanded", "true");
        caret?.classList.add("rotate-180");
    };
    const megaClose = () => {
        mega?.classList.add("opacity-0");
        trigger?.setAttribute("aria-expanded", "false");
        caret?.classList.remove("rotate-180");
        megaTimer = setTimeout(() => mega?.classList.add("invisible"), 200);
    };
    // small delay so the gap between trigger and panel doesn't close it
    const scheduleClose = () => {
        megaTimer = setTimeout(megaClose, 150);
    };

    trigger?.addEventListener("mouseenter", megaOpen);
    trigger?.addEventListener("mouseleave", scheduleClose);
    trigger?.addEventListener("focus", megaOpen);
    mega?.addEventListener("mouseenter", () => clearTimeout(megaTimer));
    mega?.addEventListener("mouseleave", scheduleClose);
    trigger?.addEventListener("click", () =>
        trigger.getAttribute("aria-expanded") === "true"
            ? megaClose()
            : megaOpen(),
    );
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") megaClose();
    });
    document.addEventListener("click", (e) => {
        const t = e.target as Node;
        if (!trigger?.contains(t) && !mega?.contains(t)) megaClose();
    });
</script>
