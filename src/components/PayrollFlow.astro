---
import { Icon } from "astro-icon/components";

// Payroll diagram: a salary run producing payslips, with Kenyan statutory
// deductions (PAYE, NHIF, NSSF) handled automatically. Left = the run sweeping
// the team; right = one payslip broken down to net pay. Grounded in the real
// module: monthly/weekly runs, payslips, allowances, PAYE/NHIF/NSSF, advances,
// loans, posted to the books.

const employees = [
    { initials: "GW", name: "Grace Wanjiku", role: "Cashier", d: "0s" },
    { initials: "JO", name: "John Otieno", role: "Stock clerk", d: "0.5s" },
    { initials: "AS", name: "Amina Said", role: "Supervisor", d: "1s" },
];

// One payslip, broken down. + = allowance, − = deduction.
const lines = [
    { label: "Gross", raw: 60000, amt: "60,000", cls: "text-slate-400", amtCls: "font-semibold text-brand-dark" },
    { label: "+ Transport", raw: 8000, amt: "8,000", cls: "text-green-600", amtCls: "text-green-600" },
    { label: "+ Housing", raw: 12000, amt: "12,000", cls: "text-green-600", amtCls: "text-green-600" },
    { label: "− PAYE", raw: 9200, amt: "9,200", cls: "text-rose-500", amtCls: "text-rose-500" },
    { label: "− NHIF", raw: 1700, amt: "1,700", cls: "text-rose-500", amtCls: "text-rose-500" },
    { label: "− NSSF", raw: 1080, amt: "1,080", cls: "text-rose-500", amtCls: "text-rose-500" },
];
---

<div class="pay w-full">
    <div class="rounded-3xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
        <span
            class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-semibold text-brand-dark ring-1 ring-slate-200"
        >
            <Icon name="material-symbols:badge-outline" class="size-3.5 text-brand" />
            Payroll run · March
            <span class="font-normal text-slate-400">· monthly</span>
        </span>

        <!-- Desktop: run + payslip -->
        <div class="mt-5 hidden grid-cols-[1fr_1.5fr] items-start gap-4 sm:grid">
            <!-- Run: employees getting paid -->
            <div>
                <div class="space-y-2">
                    {
                        employees.map((e) => (
                            <div class="flex items-center gap-2.5 rounded-xl bg-white p-2.5 shadow-sm ring-1 ring-slate-200">
                                <span class="flex size-8 items-center justify-center rounded-full bg-blue-50 text-[11px] font-bold text-brand">
                                    {e.initials}
                                </span>
                                <div class="min-w-0 leading-tight">
                                    <p class="truncate text-xs font-semibold text-brand-dark">
                                        {e.name}
                                    </p>
                                    <p class="truncate text-[10px] text-slate-400">
                                        {e.role}
                                    </p>
                                </div>
                                <Icon
                                    name="material-symbols:check-circle"
                                    class="emp-check ml-auto size-4 shrink-0 text-green-600"
                                    style={`--d:${e.d}`}
                                />
                            </div>
                        ))
                    }
                </div>
                <!-- run progress -->
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-200">
                    <span class="run-bar block h-full rounded-full bg-brand"></span>
                </div>
                <p class="mt-2 text-[11px] text-slate-400">
                    14 employees · payslips sent
                </p>
            </div>

            <!-- Payslip breakdown -->
            <div class="rounded-2xl bg-white p-4 shadow-md ring-1 ring-slate-200">
                <div class="flex items-center justify-between">
                    <div class="leading-tight">
                        <p class="text-sm font-bold text-brand-dark">Grace Wanjiku</p>
                        <p class="text-xs text-slate-400">March payslip</p>
                    </div>
                    <Icon name="material-symbols:description-outline" class="size-5 text-brand" />
                </div>
                <div class="mt-3 space-y-1.5 text-sm">
                    {
                        lines.map((l) => (
                            <div class="flex items-center justify-between">
                                <span class={`whitespace-nowrap ${l.cls}`}>{l.label}</span>
                                <span class={`num whitespace-nowrap ${l.amtCls}`} data-to={l.raw}>
                                    {l.amt}
                                </span>
                            </div>
                        ))
                    }
                </div>
                <div class="mt-2 flex items-center justify-between border-t border-slate-100 pt-2.5">
                    <span class="text-sm font-semibold text-brand-dark">Net pay</span>
                    <span
                        class="pay-net num whitespace-nowrap text-base font-bold text-brand"
                        data-to="68020"
                        data-prefix="Ksh "
                    >
                        Ksh 68,020
                    </span>
                </div>
            </div>
        </div>

        <!-- Mobile: simple 3-step -->
        <div class="mt-4 flex flex-col gap-2 sm:hidden">
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <span class="flex size-9 items-center justify-center rounded-lg bg-blue-50 text-brand">
                    <Icon name="material-symbols:groups-outline" class="size-5" />
                </span>
                <div>
                    <p class="text-sm font-semibold text-brand-dark">Run salaries</p>
                    <p class="text-xs text-slate-400">Monthly or weekly, whole team</p>
                </div>
            </div>
            <Icon name="material-symbols:keyboard-arrow-down" class="mx-auto size-4 text-slate-300" />
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <span class="flex size-9 items-center justify-center rounded-lg bg-rose-50 text-rose-500">
                    <Icon name="material-symbols:receipt-long-outline" class="size-5" />
                </span>
                <div>
                    <p class="text-sm font-semibold text-brand-dark">PAYE, NHIF, NSSF</p>
                    <p class="text-xs text-slate-400">Statutory deductions handled</p>
                </div>
            </div>
            <Icon name="material-symbols:keyboard-arrow-down" class="mx-auto size-4 text-slate-300" />
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <span class="flex size-9 items-center justify-center rounded-lg bg-green-50 text-green-600">
                    <Icon name="material-symbols:check-circle" class="size-5" />
                </span>
                <div>
                    <p class="text-sm font-semibold text-brand-dark">Payslips sent</p>
                    <p class="text-xs text-slate-400">Net pay, posted to the books</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Checks pop in one by one — the run processing the team. */
    .emp-check {
        animation: emp-in 4s ease-in-out infinite;
        animation-delay: var(--d, 0s);
        transform-origin: center;
    }
    @keyframes emp-in {
        0%, 6% { opacity: 0; transform: scale(0.5); }
        16%, 84% { opacity: 1; transform: scale(1); }
        94%, 100% { opacity: 0; transform: scale(0.5); }
    }
    .run-bar {
        width: 0;
        animation: run-fill 4s ease-in-out infinite;
    }
    @keyframes run-fill {
        0% { width: 0; }
        45%, 90% { width: 100%; }
        100% { width: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
        .emp-check,
        .run-bar {
            animation: none;
        }
        .emp-check { opacity: 1; }
        .run-bar { width: 100%; }
    }
</style>

<script>
    // Count the payslip figures up on a loop, in sync with the run bar (~4s).
    const root = document.querySelector<HTMLElement>(".pay");
    if (root) {
        const nums = [...root.querySelectorAll<HTMLElement>(".num")];
        const fmt = (n: number) => n.toLocaleString("en-US");
        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        const setFinal = () => {
            for (const el of nums) {
                el.textContent =
                    (el.dataset.prefix ?? "") + fmt(Number(el.dataset.to));
            }
        };

        const countUp = () => {
            const dur = 1100;
            let start = 0;
            const step = (t: number) => {
                if (!start) start = t;
                const p = Math.min(1, (t - start) / dur);
                const e = 1 - Math.pow(1 - p, 3); // easeOutCubic
                for (const el of nums) {
                    const to = Number(el.dataset.to);
                    el.textContent =
                        (el.dataset.prefix ?? "") + fmt(Math.round(to * e));
                }
                if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
        };

        if (reduce) {
            setFinal();
        } else {
            let timer: ReturnType<typeof setInterval> | undefined;
            const io = new IntersectionObserver(
                (entries) => {
                    for (const e of entries) {
                        if (e.isIntersecting) {
                            countUp();
                            clearInterval(timer);
                            timer = setInterval(countUp, 4000);
                        } else {
                            clearInterval(timer);
                        }
                    }
                },
                { threshold: 0.3 },
            );
            io.observe(root);
        }
    }
</script>
